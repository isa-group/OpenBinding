{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "gen:api": "node scripts/gen-api.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js}\"",
    "preview": "vite preview",
    "test": "vitest run --project app --project corpus",
    "test:watch": "vitest --project app --project corpus",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/lint": "6.9.3",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.11",
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^10",
    "@dnd-kit/utilities": "^3",
    "@fontsource-variable/inter": "5",
    "@fontsource/jetbrains-mono": "5",
    "@monaco-editor/react": "^4",
    "@tailwindcss/vite": "^4",
    "@uiw/react-codemirror": "^4.25.4",
    "bpmn-js": "^18.22.1",
    "date-fns": "^4",
    "framer-motion": "^12",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "lz-string": "1.5.0",
    "monaco-editor": "^0.52",
    "pricing-renderer": "0.2.0",
    "pricing4ts": "0.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14",
    "react-easy-crop": "^5",
    "react-helmet-async": "^3",
    "react-icons": "^5",
    "react-loading-skeleton": "^3",
    "react-markdown": "^10",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "remark-gfm": "^4",
    "space-react-client": "^0.4.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-boundaries": "7.3.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "6.2.7",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "^0.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}

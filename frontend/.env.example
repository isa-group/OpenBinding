# OpenBinding Gateway API Base URL. `/api` goes through the Vite dev proxy (vite.config.ts) to the gateway, so the SPA and the
# gateway share one origin: the session is an HttpOnly cookie the gateway sets, which a cross-origin API would not receive.
VITE_API_BASE_URL=/api

# Public URLs of sibling frontends. Never put keys or secrets in VITE_* variables.
VITE_SPACE_FRONTEND_URL=https://space.score.us.es
VITE_SPHERE_URL=https://sphere.score.us.es

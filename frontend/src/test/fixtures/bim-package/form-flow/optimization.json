{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "hello-optimization"
  },
  "spec": {
    "criteria": [
      {
        "id": "latency",
        "feature": {
          "resource": "application",
          "id": "latency"
        },
        "normalize": {
          "min": 10,
          "max": 20,
          "clamp": false
        }
      },
      {
        "id": "criterion2",
        "feature": {
          "resource": "application",
          "id": "cost"
        },
        "normalize": {
          "min": 0.5,
          "max": 0.8,
          "clamp": false
        }
      }
    ],
    "penalties": [
      {
        "constraint": {
          "resource": "constraints",
          "id": "constraint2"
        },
        "weight": 1
      }
    ]
  }
}

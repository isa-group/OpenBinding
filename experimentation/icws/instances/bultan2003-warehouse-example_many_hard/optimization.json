{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "bultan2003_warehouse_example_many_hard_optimization"
  },
  "spec": {
    "criteria": [
      {
        "id": "availability",
        "feature": {
          "resource": "application",
          "id": "availability"
        },
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "id": "cost_usd",
        "feature": {
          "resource": "application",
          "id": "cost_usd"
        },
        "normalize": {
          "min": 0,
          "max": 1000,
          "clamp": true
        }
      },
      {
        "id": "latency_ms",
        "feature": {
          "resource": "application",
          "id": "latency_ms"
        },
        "normalize": {
          "min": 0,
          "max": 5000,
          "clamp": true
        }
      },
      {
        "id": "reliability",
        "feature": {
          "resource": "application",
          "id": "reliability"
        },
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "id": "security",
        "feature": {
          "resource": "application",
          "id": "security"
        },
        "normalize": {
          "min": 1,
          "max": 5,
          "clamp": true
        }
      }
    ]
  }
}

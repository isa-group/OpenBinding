{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "cremaschi2018_textbook_access_mono_utility_hard_optimization"
  },
  "spec": {
    "mode": "weighted",
    "terms": [
      {
        "metric": {
          "resource": "application",
          "id": "availability"
        },
        "weight": 0.2,
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "cost_usd"
        },
        "weight": 0.2,
        "normalize": {
          "min": 0,
          "max": 10,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "latency_ms"
        },
        "weight": 0.2,
        "normalize": {
          "min": 0,
          "max": 10000,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "reliability"
        },
        "weight": 0.2,
        "normalize": {
          "min": 0.0,
          "max": 1.0,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "security"
        },
        "weight": 0.2,
        "normalize": {
          "min": 1,
          "max": 5,
          "clamp": true
        }
      }
    ]
  }
}

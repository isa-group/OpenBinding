{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "bultan2003_warehouse_example_multi_hard_optimization"
  },
  "spec": {
    "mode": "pareto",
    "terms": [
      {
        "metric": {
          "resource": "application",
          "id": "availability"
        },
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "cost_usd"
        },
        "normalize": {
          "min": 0,
          "max": 1000,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "latency_ms"
        },
        "normalize": {
          "min": 0,
          "max": 5000,
          "clamp": true
        }
      }
    ]
  }
}

{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "zhang2014_entertainment_planner_running_example_mono_utility_hard_optimization"
  },
  "spec": {
    "mode": "weighted",
    "terms": [
      {
        "metric": {
          "resource": "application",
          "id": "availability"
        },
        "weight": 0.17,
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "cost"
        },
        "weight": 0.17,
        "normalize": {
          "min": 0,
          "max": 1000,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "distance"
        },
        "weight": 0.17,
        "normalize": {
          "min": 0,
          "max": 50000,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "reliability"
        },
        "weight": 0.17,
        "normalize": {
          "min": 0.0,
          "max": 1.0,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "security"
        },
        "weight": 0.16,
        "normalize": {
          "min": 1,
          "max": 5,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "time"
        },
        "weight": 0.16,
        "normalize": {
          "min": 0,
          "max": 1440,
          "clamp": true
        }
      }
    ]
  }
}

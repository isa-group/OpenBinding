{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "pautasso2009_restful_ecommerce_mono_one_soft_optimization"
  },
  "spec": {
    "mode": "weighted",
    "terms": [
      {
        "metric": {
          "resource": "application",
          "id": "availability"
        },
        "weight": 1.0,
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      }
    ],
    "penalties": [
      {
        "constraint": {
          "resource": "constraints",
          "id": "bind_shop_mono_provider"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "bind_catalog_mono_provider"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "bind_payment_mono_provider"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "gen_c_global_latency_ms_1"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "gen_c_local_t_checkout_security_1"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "gen_c_dep_same_1"
        },
        "weight": 1
      }
    ]
  }
}

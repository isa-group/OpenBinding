{
  "apiVersion": "qos-binding/v1",
  "kind": "ConstraintSet",
  "metadata": {
    "name": "zhang2014_entertainment_planner_running_example_many_hard_constraints"
  },
  "spec": {
    "constraints": {
      "c_within_2km": {
        "assert": "features.distance <= 2000",
        "enforcement": "hard"
      },
      "c_time_budget": {
        "assert": "features.time <= 240",
        "enforcement": "hard"
      },
      "c_cost_budget": {
        "assert": "features.cost <= 100",
        "enforcement": "hard"
      },
      "gen_c_dep_same_1": {
        "assert": "tasks.t_dining.provider == tasks.t_movie.provider",
        "enforcement": "hard"
      }
    }
  }
}

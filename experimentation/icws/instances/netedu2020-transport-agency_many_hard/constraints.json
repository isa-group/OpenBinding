{
  "apiVersion": "qos-binding/v1",
  "kind": "ConstraintSet",
  "metadata": {
    "name": "netedu2020_transport_agency_many_hard_constraints"
  },
  "spec": {
    "constraints": {
      "gen_c_global_cost_1": {
        "assert": "metrics.cost <= 11.01",
        "enforcement": "hard"
      },
      "gen_c_local_t_get_closest_city_reliability_1": {
        "assert": "tasks.t_get_closest_city.metrics.reliability >= 0.9833",
        "enforcement": "hard"
      },
      "gen_c_dep_same_1": {
        "assert": "tasks.t_get_closest_city.provider == tasks.t_get_country_from_location.provider",
        "enforcement": "hard"
      }
    }
  }
}

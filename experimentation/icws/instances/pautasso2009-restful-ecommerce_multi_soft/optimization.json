{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "pautasso2009_restful_ecommerce_multi_soft_optimization"
  },
  "spec": {
    "mode": "pareto",
    "terms": [
      {
        "metric": {
          "resource": "application",
          "id": "availability"
        },
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "cost_usd"
        },
        "normalize": {
          "min": 0,
          "max": 1000,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "latency_ms"
        },
        "normalize": {
          "min": 0,
          "max": 5000,
          "clamp": true
        }
      }
    ],
    "penalties": [
      {
        "constraint": {
          "resource": "constraints",
          "id": "bind_shop_mono_provider"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "bind_catalog_mono_provider"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "bind_payment_mono_provider"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "gen_c_global_latency_ms_1"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "gen_c_local_t_checkout_security_1"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "gen_c_dep_same_1"
        },
        "weight": 1
      }
    ]
  }
}

{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "zhang2014_entertainment_planner_running_example_many_soft_optimization"
  },
  "spec": {
    "mode": "pareto",
    "terms": [
      {
        "metric": {
          "resource": "application",
          "id": "availability"
        },
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "cost"
        },
        "normalize": {
          "min": 0,
          "max": 1000,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "distance"
        },
        "normalize": {
          "min": 0,
          "max": 50000,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "reliability"
        },
        "normalize": {
          "min": 0.0,
          "max": 1.0,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "security"
        },
        "normalize": {
          "min": 1,
          "max": 5,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "time"
        },
        "normalize": {
          "min": 0,
          "max": 1440,
          "clamp": true
        }
      }
    ],
    "penalties": [
      {
        "constraint": {
          "resource": "constraints",
          "id": "c_within_2km"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "c_time_budget"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "c_cost_budget"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "gen_c_global_cost_1"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "gen_c_local_t_movie_availability_1"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "gen_c_dep_same_1"
        },
        "weight": 1
      }
    ]
  }
}

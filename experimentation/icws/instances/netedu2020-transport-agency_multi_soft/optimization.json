{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "netedu2020_transport_agency_multi_soft_optimization"
  },
  "spec": {
    "mode": "pareto",
    "terms": [
      {
        "metric": {
          "resource": "application",
          "id": "availability"
        },
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "cost"
        },
        "normalize": {
          "min": 0,
          "max": 1000,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "execution_time"
        },
        "normalize": {
          "min": 0,
          "max": 20000,
          "clamp": true
        }
      }
    ],
    "penalties": [
      {
        "constraint": {
          "resource": "constraints",
          "id": "gen_c_global_cost_1"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "gen_c_local_t_get_closest_city_reliability_1"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "gen_c_dep_same_1"
        },
        "weight": 1
      }
    ]
  }
}

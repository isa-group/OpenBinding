# Docker Compose profile selector: dev | prod
COMPOSE_PROFILES=dev

# Frontend API base URL used at build time
VITE_API_BASE_URL_DEV=http://localhost:8000
VITE_API_BASE_URL_PROD=/api

# Backend CORS policies
CORS_ALLOW_ORIGINS_DEV=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS_PROD=https://openbinding.score.us.es,https://openbinding.us.es

# Accounts database. The dev profile is happy with these defaults; production
# should be given a real password.
POSTGRES_DB=openbinding
POSTGRES_USER=openbinding
POSTGRES_PASSWORD=openbinding

# Signs the gateway's session tokens. The dev profile falls back to a known
# development value; the prod profile refuses to start until this is set.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_JWT_SECRET=

# Whether solving requires an account. Analysis and the schemas stay public
# either way.
AUTH_REQUIRED_FOR_SOLVE=true

# TLS certificates directory for production nginx
# This directory must contain:
# - fullchain.pem
# - privkey.pem
NGINX_SSL_DIR=./nginx/ssl

# Optional corporate proxy (primarily used during Docker build)
# Leave empty if you are not behind a proxy.
HTTP_PROXY_ARG=
HTTPS_PROXY_ARG=
NO_PROXY_ARG=localhost,127.0.0.1,gateway,gateway-dev,engine-minizinc,engine-random-search,engine-many-heuristic,engine-evolutionary-heuristics,frontend-dev,frontend-prod,nginx,nginx-dev

# For pricing updates, you need to provide a Google Cloud API key with access to the Google Cloud Pricing API.
GOOGLE_CLOUD_API_KEY=XXX
# The first administrator, seeded at startup. Without it a fresh deployment
# has nobody who can promote anybody, since promoting is an administrator's
# job. Ignored once any administrator exists.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

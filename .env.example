# Docker Compose profile selector: dev | prod
COMPOSE_PROFILES=dev

# Frontend API base URL used at build time
VITE_API_BASE_URL_DEV=http://localhost:8000
VITE_API_BASE_URL_PROD=/api

# Backend CORS policies
# Each entry must be scheme://host[:port] with no path, query, fragment or
# userinfo, written exactly as a browser sends it in Origin: lower-case, no
# trailing "/", default port omitted (http://localhost, not http://localhost:80).
CORS_ALLOW_ORIGINS_DEV=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS_PROD=https://openbinding.score.us.es,https://openbinding.us.es

# Accounts database. The dev profile is happy with these defaults; production
# should be given a real password.
POSTGRES_DB=openbinding
POSTGRES_USER=openbinding
POSTGRES_PASSWORD=openbinding

# Signs the gateway's session tokens. The dev profile falls back to a known
# development value; the prod profile refuses to start until this is set.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_JWT_SECRET=

# Whether solving requires an account. The schemas stay public either way.
AUTH_REQUIRED_FOR_SOLVE=true

# TLS certificates directory for production nginx
# This directory must contain:
# - fullchain.pem
# - privkey.pem
NGINX_SSL_DIR=./nginx/ssl

# Optional corporate proxy (primarily used during Docker build)
# Leave empty if you are not behind a proxy.
HTTP_PROXY_ARG=
HTTPS_PROXY_ARG=
NO_PROXY_ARG=localhost,127.0.0.1,postgres,redis,gateway,gateway-dev,worker,worker-dev,engine-minizinc,engine-random-search,engine-many-heuristic,engine-multi-heuristic,engine-evolutionary-heuristics,frontend-dev,frontend-prod,nginx,nginx-dev

# The first administrator, seeded at startup. Without it a fresh deployment
# has nobody who can promote anybody, since promoting is an administrator's
# job. Ignored once any administrator exists.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional, for an empty database only: set to true to also create an `admin`
# account using BOOTSTRAP_ADMIN_PASSWORD (at least 10 characters). There is no
# default account or password; without this and a password nothing is seeded.
SEED_DEFAULT_ADMIN=false

# Durable execution and content-addressed artifacts
REDIS_URL=redis://redis:6379/0
JOB_DISPATCH_MODE=dramatiq
ARTIFACT_ROOT=/var/lib/openbinding/artifacts
PUBLIC_BASE_URL=http://localhost:8000
# Infrastructure guardrails; pricing publication fails if a plan promises more.
ENGINE_SOLVE_TIMEOUT_S=1800
TECHNICAL_MAX_PAYLOAD_BYTES=536870912
PRICING_DOCUMENT_MAX_BYTES=2097152

# Who signs people in: local (OpenBinding's own accounts, for development, labs
# and rollback) or scoretech (SCORETech Identity through the gateway; see
# docs/IDENTITY.md). The SCORETECH_* values are read only with scoretech.
AUTH_PROVIDER=local
# SCORETECH_IDENTITY_ISSUER=https://sphere.score.us.es/identity/auth/realms/score
# SCORETECH_IDENTITY_CLIENT_ID=
# The client secret; prefer SCORETECH_IDENTITY_CLIENT_SECRET_FILE in containers.
# SCORETECH_IDENTITY_CLIENT_SECRET=
# Defaults: PUBLIC_BASE_URL + /api/v1/auth/identity/callback, and the issuer's /account/.
# SCORETECH_IDENTITY_CALLBACK_URL=
# SCORETECH_IDENTITY_ACCOUNT_URL=
# Labs only: where the gateway reaches the realm when that is not the issuer's host.
# SCORETECH_IDENTITY_TRANSPORT_URL=
# SCORETECH_IDENTITY_REQUIRED_PERMISSION=openbinding:access
# Extra browser origins the sign-in routes accept besides FRONTEND_URL's.
# AUTH_TRUSTED_ORIGINS=
# RESEARCH for a verified email of these domains (exact match after the last @).
# RESEARCH_EMAIL_DOMAINS=us.es,alum.us.es
# The Identity `sub` promoted to administrator while no administrator exists.
# BOOTSTRAP_ADMIN_SUB=

# Universidad de Sevilla CAS 2.0. Use preproduction locally and production in
# the deployed environment. CAS exchanges are one-use records in Redis.
CAS_ENABLED=false
CAS_ENVIRONMENT=preproduction
CAS_BASE_URL=
FRONTEND_URL=http://localhost:5173

# SPHERE owns OpenBinding/openbinding and every immutable pricing revision. The gateway reads it
# anonymously (OpenBinding holds no SPHERE key of its own); an organization connects its own key in
# the app, and an on-premise registry carries its key in SPHERE_REGISTRIES.
SPHERE_ENABLED=false
SPHERE_URL=https://sphere.score.us.es

# SPACE is remote (https://space.score.us.es); no copy runs locally.
# SPACE_API_KEY needs the MANAGEMENT scope. Create it in the SPACE console.
# The lab pricing-bootstrap reads DEMO_SPACE_MANAGEMENT_KEY (a MANAGEMENT key of the remote SPACE) from a root-only
# secret file supplied by the lab supervisor; never set it here.
SPACE_ENABLED=false
SPACE_URL=https://space.score.us.es
SPACE_API_KEY=
SPACE_TIMEOUT_MS=5000
SPACE_FAIL_MODE=open
SPACE_PRICING_VERSION=0.2.0
# The SPACE organization pricing tokens are issued for (their aud and organizationId). Required when
# SPACE_ENABLED=true: the gateway verifies every pricing token against SPACE's published keys (JWKS).
SPACE_ORGANIZATION_ID=
# The iss of SPACE's pricing tokens (SPACE's JWT_ISSUER) and the tolerance for their exp, in seconds.
SPACE_TOKEN_ISSUER=space
SPACE_TOKEN_LEEWAY_S=30

# Optional email delivery; the in-product inbox works without SMTP.
SMTP_URL=
MAIL_FROM=

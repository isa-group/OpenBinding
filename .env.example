# Docker Compose profile selector: dev | prod
COMPOSE_PROFILES=dev

# Frontend API base URL used at build time
VITE_API_BASE_URL_DEV=http://localhost:8000
VITE_API_BASE_URL_PROD=/api

# Backend CORS policies
CORS_ALLOW_ORIGINS_DEV=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS_PROD=https://openbinding.score.us.es,https://openbinding.us.es

# Accounts database. The dev profile is happy with these defaults; production
# should be given a real password.
POSTGRES_DB=openbinding
POSTGRES_USER=openbinding
POSTGRES_PASSWORD=openbinding

# Signs the gateway's session tokens. The dev profile falls back to a known
# development value; the prod profile refuses to start until this is set.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_JWT_SECRET=

# Whether solving requires an account. Analysis and the schemas stay public
# either way.
AUTH_REQUIRED_FOR_SOLVE=true

# TLS certificates directory for production nginx
# This directory must contain:
# - fullchain.pem
# - privkey.pem
NGINX_SSL_DIR=./nginx/ssl

# Optional corporate proxy (primarily used during Docker build)
# Leave empty if you are not behind a proxy.
HTTP_PROXY_ARG=
HTTPS_PROXY_ARG=
NO_PROXY_ARG=localhost,127.0.0.1,postgres,redis,gateway,gateway-dev,worker,worker-dev,space-server,space-mongodb,space-redis,engine-minizinc,engine-random-search,engine-many-heuristic,engine-multi-heuristic,engine-evolutionary-heuristics,frontend-dev,frontend-prod,nginx,nginx-dev

# For pricing updates, you need to provide a Google Cloud API key with access to the Google Cloud Pricing API.
GOOGLE_CLOUD_API_KEY=XXX
# The first administrator, seeded at startup. Without it a fresh deployment
# has nobody who can promote anybody, since promoting is an administrator's
# job. Ignored once any administrator exists.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Durable execution and content-addressed artifacts
REDIS_URL=redis://redis:6379/0
JOB_DISPATCH_MODE=dramatiq
ARTIFACT_ROOT=/var/lib/openbinding/artifacts
PUBLIC_BASE_URL=http://localhost:8000
# Infrastructure guardrails; pricing publication fails if a plan promises more.
ENGINE_SOLVE_TIMEOUT_S=1800
TECHNICAL_MAX_PAYLOAD_BYTES=536870912
PRICING_DOCUMENT_MAX_BYTES=2097152

# Universidad de Sevilla CAS 2.0. Use preproduction locally and production in
# the deployed environment. CAS exchanges are one-use records in Redis.
CAS_ENABLED=false
CAS_ENVIRONMENT=preproduction
CAS_BASE_URL=
FRONTEND_URL=http://localhost:5173

# SPHERE owns OpenBinding/openbinding and every immutable pricing revision.
# The API key is sent server-to-server as x-api-key and never reaches Vite.
SPHERE_ENABLED=false
SPHERE_URL=https://sphere.score.us.es
SPHERE_API_KEY=
SPHERE_ORGANIZATION_ID=

# SPACE v1.5 contract evaluation and pricing deployments.
SPACE_ENABLED=false
SPACE_URL=http://space-server:3000
SPACE_API_KEY=
SPACE_DESTRUCTIVE_API_KEY=
SPACE_TIMEOUT_MS=5000
SPACE_FAIL_MODE=open
SPACE_PRICING_VERSION=0.1.0

# Optional local SPACE 1.5 profile. SPACE_SOURCE_DIR must point to an exact
# v1.5.0 checkout of https://github.com/isa-group/space.
SPACE_SOURCE_DIR=./space/space-src
SPACE_ADMIN_USER=admin
SPACE_ADMIN_PASSWORD=
SPACE_JWT_SECRET=
SPACE_JWT_SALT=
SPACE_DATABASE_ROOT_USERNAME=root
SPACE_DATABASE_ROOT_PASSWORD=
SPACE_DATABASE_NAME=space_db

# Optional email delivery; the in-product inbox works without SMTP.
SMTP_URL=
MAIL_FROM=

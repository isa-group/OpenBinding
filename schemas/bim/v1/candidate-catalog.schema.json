{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bim.dev/schema/bim/v1/candidate-catalog.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "qos-binding/v1"},
    "kind": {"const": "CandidateCatalog"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "required": ["metricBindings", "candidates"],
      "properties": {
        "providers": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
          "additionalProperties": {"$ref": "#/$defs/provider"}
        },
        "metricBindings": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
          "additionalProperties": {"$ref": "#/$defs/ref"}
        },
        "candidates": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
          "additionalProperties": {"$ref": "#/$defs/candidate"}
        },
        "extensions": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "annotations": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "properties": {"$ref": "#/$defs/propertyMap"}
      },
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "required": ["resource", "id"],
      "properties": {
        "resource": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "capability": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "properties": {"$ref": "#/$defs/propertyMap"}
          },
          "additionalProperties": false
        }
      ]
    },
    "provides": {
      "oneOf": [
        {"$ref": "#/$defs/capability"},
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}}
      ]
    },
    "candidate": {
      "type": "object",
      "required": ["provides", "metrics"],
      "properties": {
        "name": {"type": "string"},
        "provider": {"$ref": "#/$defs/ref"},
        "provides": {"$ref": "#/$defs/provides"},
        "properties": {"$ref": "#/$defs/propertyMap"},
        "metrics": {"type": "object", "additionalProperties": {"type": "number"}},
        "extensions": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "propertyMap": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    }
  }
}

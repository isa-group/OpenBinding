{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bim.dev/schema/bim/v1/constraint-set.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "qos-binding/v1"},
    "kind": {"const": "ConstraintSet"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "required": ["constraints"],
      "properties": {
        "constraints": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
          "additionalProperties": {"$ref": "#/$defs/constraint"}
        },
        "extensions": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "annotations": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "expression": {
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": {
              "oneOf": [
                {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
                {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["literal"],
          "properties": {"literal": {"type": ["string", "number", "boolean", "null"]}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "left", "right"],
          "properties": {
            "op": {"enum": ["and", "or", "eq", "ne", "lt", "lte", "gt", "gte", "add", "sub", "mul", "div", "pow", "scale", "power"]},
            "left": {"$ref": "#/$defs/expression"},
            "right": {"$ref": "#/$defs/expression"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "value"],
          "properties": {"op": {"enum": ["not", "negate"]}, "value": {"$ref": "#/$defs/expression"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "args"],
          "properties": {
            "op": {"enum": ["has", "min", "max", "sum", "product", "weightedSum", "weightedProduct"]},
            "args": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/expression"}}
          },
          "additionalProperties": false
        }
      ]
    },
    "constraint": {
      "type": "object",
      "required": ["assert", "enforcement"],
      "properties": {
        "when": {"$ref": "#/$defs/expression"},
        "assert": {"$ref": "#/$defs/expression"},
        "enforcement": {"enum": ["hard", "soft"]},
        "penalty": {"$ref": "#/$defs/expression"},
        "extensions": {"type": "object", "additionalProperties": true}
      },
      "allOf": [
        {
          "if": {"properties": {"enforcement": {"const": "soft"}}, "required": ["enforcement"]},
          "then": {"required": ["penalty"]},
          "else": {"not": {"required": ["penalty"]}}
        }
      ],
      "additionalProperties": false
    }
  }
}

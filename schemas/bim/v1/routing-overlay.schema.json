{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bim.dev/schema/bim/v1/routing-overlay.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "qos-binding/v1"},
    "kind": {"const": "RoutingOverlay"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "properties": {
        "uniform": {"const": true},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/entry"}
        },
        "extensions": {"type": "object", "additionalProperties": true}
      },
      "oneOf": [
        {"required": ["uniform"], "not": {"required": ["entries"]}},
        {"required": ["entries"], "not": {"required": ["uniform"]}}
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "annotations": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "required": ["resource", "id"],
      "properties": {
        "resource": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["target", "probability"],
      "properties": {
        "target": {"$ref": "#/$defs/ref"},
        "probability": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  }
}

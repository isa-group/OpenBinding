{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bim.dev/schema/bim/v1/application.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "qos-binding/v1"},
    "kind": {"const": "Application"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "required": ["tasks", "metrics", "workflow"],
      "properties": {
        "tasks": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
          "additionalProperties": {"$ref": "#/$defs/task"}
        },
        "metrics": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
          "additionalProperties": {"$ref": "#/$defs/metric"}
        },
        "workflow": {"$ref": "#/$defs/node"},
        "extensions": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "annotations": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "resourceRef": {
      "type": "object",
      "required": ["resource", "id"],
      "properties": {
        "resource": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "requirement": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "predicate": {"$ref": "#/$defs/expression"}
          },
          "additionalProperties": false
        }
      ]
    },
    "task": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "properties": {
            "kind": {"enum": ["service", "local"]},
            "name": {"type": "string"},
            "requires": {"$ref": "#/$defs/requirement"},
            "extensions": {"type": "object", "additionalProperties": true}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "local"}}, "required": ["kind"]},
              "then": {"not": {"required": ["requires"]}},
              "else": {"required": ["requires"]}
            }
          ],
          "additionalProperties": false
        }
      ]
    },
    "domain": {
      "oneOf": [
        {"enum": ["real", "integer", "ratio"]},
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["real", "integer", "ratio"]},
            "minimum": {"type": "number"},
            "maximum": {"type": "number"}
          },
          "additionalProperties": false
        }
      ]
    },
    "aggregateOperator": {
      "oneOf": [
        {"enum": ["sum", "product", "min", "max", "weightedSum", "weightedProduct", "scale", "power", "identity"]},
        {
          "type": "object",
          "required": ["expression"],
          "properties": {"expression": {"$ref": "#/$defs/expression"}},
          "additionalProperties": false
        }
      ]
    },
    "aggregation": {
      "oneOf": [
        {"enum": ["sum", "product", "min", "max"]},
        {
          "type": "object",
          "properties": {
            "sequence": {"$ref": "#/$defs/aggregateOperator"},
            "parallel": {"$ref": "#/$defs/aggregateOperator"},
            "exclusive": {"$ref": "#/$defs/aggregateOperator"},
            "repeat": {"$ref": "#/$defs/aggregateOperator"},
            "selection": {"$ref": "#/$defs/aggregateOperator"}
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      ]
    },
    "metric": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "type": {"const": "number"},
        "unit": {"type": "string", "minLength": 1},
        "domain": {"$ref": "#/$defs/domain"},
        "direction": {"enum": ["minimize", "maximize"]},
        "scope": {"enum": ["invocation", "selectedCandidate"]},
        "aggregation": {"$ref": "#/$defs/aggregation"},
        "neutral": {"type": "number"},
        "extensions": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "branch": {
      "type": "object",
      "required": ["id", "flow"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "flow": {"$ref": "#/$defs/node"},
        "when": {"$ref": "#/$defs/expression"},
        "extensions": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "task": {"$ref": "#/$defs/resourceRef"},
        "empty": {"const": true},
        "sequence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "parallel": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "exclusive": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/branch"}},
        "repeat": {
          "type": "object",
          "required": ["body"],
          "properties": {
            "body": {"$ref": "#/$defs/node"},
            "count": {"type": "integer", "minimum": 0},
            "expectedCount": {"type": "number", "minimum": 0}
          },
          "oneOf": [
            {"required": ["count"], "not": {"required": ["expectedCount"]}},
            {"required": ["expectedCount"], "not": {"required": ["count"]}}
          ],
          "additionalProperties": false
        },
        "bpmn": {"$ref": "#/$defs/resourceRef"},
        "extensions": {"type": "object", "additionalProperties": true}
      },
      "oneOf": [
        {"required": ["task"]},
        {"required": ["empty"]},
        {"required": ["sequence"]},
        {"required": ["parallel"]},
        {"required": ["exclusive"]},
        {"required": ["repeat"]},
        {"required": ["bpmn"]}
      ],
      "additionalProperties": false
    },
    "expression": {
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": {
              "oneOf": [
                {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
                {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["literal"],
          "properties": {"literal": {"type": ["string", "number", "boolean", "null"]}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "left", "right"],
          "properties": {
            "op": {"enum": ["and", "or", "eq", "ne", "lt", "lte", "gt", "gte", "add", "sub", "mul", "div", "pow", "scale", "power"]},
            "left": {"$ref": "#/$defs/expression"},
            "right": {"$ref": "#/$defs/expression"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "value"],
          "properties": {"op": {"enum": ["not", "negate"]}, "value": {"$ref": "#/$defs/expression"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "args"],
          "properties": {
            "op": {"enum": ["has", "min", "max", "sum", "product", "weightedSum", "weightedProduct"]},
            "args": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/expression"}}
          },
          "additionalProperties": false
        }
      ]
    }
  }
}

{
  "apiVersion": "bim/v1",
  "kind": "Engine",
  "metadata": {
    "namespace": "bim.builtin",
    "name": "minizinc-csp",
    "version": "1.1.1",
    "description": "Exact MiniZinc/Gecode solver for its explicitly declared BIM v1 subset (additive, min/max and multiplicative aggregations; the latter are lowered with a logarithmic linearisation plus exact flat products). 1.1.1: technical bounds and non-strict comparison literals are widened by the numeric slack before flattening (false optima on boundary bindings in 1.1.0), outputs fixed at flattening time are rendered through the .ozn pass"
  },
  "spec": {
    "modes": [
      {
        "id": "exact-weighted",
        "profile": "qos-binding/v1",
        "ir": {"apiVersion": "bim/v1", "kind": "BindingProblem"},
        "algorithm": "minizinc-csp",
        "capabilities": {
          "workflowNodes": {
            "selector": "only",
            "values": ["task", "empty", "sequence", "parallel", "exclusive.probabilistic", "repeat.count", "repeat.expectedCount"]
          },
          "aggregations": {
            "selector": "only",
            "values": [
              "sequence.sum", "sequence.product", "sequence.min", "sequence.max",
              "parallel.sum", "parallel.product", "parallel.min", "parallel.max",
              "exclusive.weightedSum", "exclusive.weightedProduct", "exclusive.min", "exclusive.max",
              "repeat.scale", "repeat.power", "repeat.identity",
              "selection.sum", "selection.product", "selection.min", "selection.max"
            ]
          },
          "featureScopes": {
            "selector": "only",
            "values": ["invocation", "selectedCandidate"]
          },
          "featureValues": {"selector": "only", "values": ["scalar"]},
          "constraints": {"selector": "only", "values": ["hard.aggregate-bound", "hard.expression", "soft.aggregate-bound", "soft.expression"]},
          "scalarizations": {"selector": "only", "values": [{"id": "weighted-sum", "objectiveTypes": ["SINGLE"], "weightPolicy": "required"}]},
          "expressions": {"selector": "only", "values": ["literal", "path.features", "path.tasks", "compare", "and"]},
          "placement": {"selector": "all"},
          "irExtensions": {"selector": "only", "values": ["qos-binding-placement/v1"]}
        },
        "optionsSchema": {
          "type": "object",
          "properties": {
            "time_budget_ms": {"type": "integer", "minimum": 1, "maximum": 3600000, "default": 30000},
            "solver": {"const": "gecode", "default": "gecode"},
            "product_constraints": {"enum": ["log", "real"], "default": "log"}
          },
          "additionalProperties": false
        },
        "limits": {"maxTasks": 10000, "maxCandidates": 100000, "maxTimeBudgetMs": 3600000},
        "guarantees": {
          "termination": ["OPTIMAL", "FEASIBLE", "INFEASIBLE", "UNKNOWN"],
          "exact": true,
          "deterministicWithoutTimeBudget": true
        }
      }
    ]
  }
}

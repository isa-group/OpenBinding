{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bim.dev/schema/bim/v1/optimization.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "qos-binding/v1"},
    "kind": {"const": "Optimization"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["satisfy", "weighted", "lexicographic", "pareto"]},
        "type": {"enum": ["MONO", "MULTI", "MANY"]},
        "terms": {"type": "array", "items": {"$ref": "#/$defs/term"}},
        "penalties": {"type": "array", "items": {"$ref": "#/$defs/penalty"}},
        "extensions": {"type": "object", "additionalProperties": true}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "satisfy"}}, "required": ["mode"]},
          "then": {"properties": {"terms": {"maxItems": 0}}},
          "else": {"required": ["terms"], "properties": {"terms": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"type": {"const": "MULTI"}}, "required": ["type"]},
          "then": {"required": ["terms"], "properties": {"terms": {"minItems": 2, "maxItems": 3}}}
        },
        {
          "if": {"properties": {"type": {"const": "MANY"}}, "required": ["type"]},
          "then": {"required": ["terms"], "properties": {"terms": {"minItems": 3}}}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "annotations": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "required": ["resource", "id"],
      "properties": {
        "resource": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "normalize": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "number"},
        "max": {"type": "number"},
        "clamp": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "term": {
      "type": "object",
      "required": ["metric"],
      "properties": {
        "metric": {"$ref": "#/$defs/ref"},
        "direction": {"enum": ["minimize", "maximize"]},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "normalize": {"$ref": "#/$defs/normalize"}
      },
      "additionalProperties": false
    },
    "penalty": {
      "type": "object",
      "required": ["constraint"],
      "properties": {
        "constraint": {"$ref": "#/$defs/ref"},
        "weight": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    }
  }
}

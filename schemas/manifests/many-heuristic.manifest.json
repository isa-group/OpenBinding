{
  "manifest_version": "1",
  "engine_id": "many-heuristic",
  "display_name": "Many-Objective Heuristic",
  "description": "Archive-based search for many-objective instances, over the JVM core the other JVM engines share.",
  "type": "HEURISTIC",
  "capabilities": {
    "qos_features_supported": [
      "*"
    ],
    "composition_nodes_supported": [
      "TASK",
      "SEQ",
      "AND",
      "XOR",
      "LOOP"
    ],
    "objective_types_supported": [
      "MANY"
    ],
    "constraints_supported": [
      "attribute_bound",
      "dependency",
      "resource_capacity",
      "latency_transition"
    ],
    "schema_version": "v1"
  },
  "options_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "many-heuristic options",
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "iterations_count": {
        "type": "integer",
        "minimum": 1,
        "default": 1000,
        "description": "Minimum number of bindings to evaluate."
      },
      "archive_size": {
        "type": "integer",
        "minimum": 1,
        "default": 20,
        "description": "How many non-dominated solutions to keep."
      },
      "seed": {
        "type": "integer",
        "description": "Fixed so that a run can be reproduced."
      },
      "time_budget_ms": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1,
        "description": "Wall-clock budget in milliseconds."
      }
    }
  },
  "instance_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://openbinding.score.us.es/api/v1/schemas/many-heuristic",
    "title": "Many-Heuristic Instance Schema",
    "description": "Profile for the Many-Heuristic Java Engine (structured workflows + many-objective + Pareto options).",
    "type": "object",
    "properties": {
      "composition": {
        "type": "object",
        "properties": {
          "type": {
            "const": "STRUCTURED"
          },
          "root": {
            "$ref": "#/$defs/random_search_node"
          }
        },
        "required": [
          "type",
          "root"
        ]
      },
      "objective": {
        "properties": {
          "type": {
            "const": "MANY"
          }
        },
        "required": [
          "type"
        ]
      },
      "constraints": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "ATTRIBUTE_BOUND"
                },
                "scope": {
                  "enum": [
                    "GLOBAL",
                    "LOCAL"
                  ]
                },
                "hard": {
                  "type": "boolean"
                },
                "tasks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "<=",
                    "<",
                    ">=",
                    ">",
                    "==",
                    "!=",
                    "IN_RANGE"
                  ]
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "min",
                        "max"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "scope",
                "op",
                "value"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "DEPENDENCY"
                },
                "type": {
                  "enum": [
                    "SAME_PROVIDER",
                    "DIFFERENT_PROVIDER",
                    "SAME_POOL",
                    "DIFFERENT_POOL",
                    "SAME_CANDIDATE",
                    "DIFFERENT_CANDIDATE"
                  ]
                },
                "hard": {
                  "type": "boolean"
                },
                "tasks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "kind",
                "type"
              ]
            }
          ]
        }
      }
    },
    "required": [
      "composition",
      "features",
      "aggregation_policies",
      "objective"
    ],
    "$defs": {
      "random_search_node": {
        "oneOf": [
          {
            "$ref": "#/$defs/task_node"
          },
          {
            "$ref": "#/$defs/seq_node"
          },
          {
            "$ref": "#/$defs/and_node"
          },
          {
            "$ref": "#/$defs/xor_node"
          },
          {
            "$ref": "#/$defs/loop_node"
          },
          {
            "$ref": "#/$defs/element_node"
          }
        ]
      },
      "task_node": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "TASK"
          }
        },
        "required": [
          "kind"
        ]
      },
      "seq_node": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "SEQ"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/random_search_node"
            }
          }
        },
        "required": [
          "kind",
          "children"
        ]
      },
      "and_node": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "AND"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/random_search_node"
            }
          }
        },
        "required": [
          "kind",
          "children"
        ]
      },
      "xor_node": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "XOR"
          },
          "branches": {
            "type": "array",
            "items": {
              "properties": {
                "child": {
                  "$ref": "#/$defs/random_search_node"
                },
                "p": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "child",
                "p"
              ]
            }
          }
        },
        "required": [
          "kind",
          "branches"
        ]
      },
      "loop_node": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "LOOP"
          },
          "body": {
            "$ref": "#/$defs/random_search_node"
          },
          "expected_iterations": {
            "type": "number",
            "minimum": 0
          },
          "bounds": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": [
              "min",
              "max"
            ]
          }
        },
        "required": [
          "kind",
          "body"
        ]
      },
      "element_node": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "ELEMENT"
          }
        },
        "required": [
          "kind"
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbinding.score.us.es/api/v1/schemas/general",
  "title": "Compact QoS-Aware Service Composition",
  "type": "object",
  "required": [
    "metadata",
    "features",
    "providers",
    "tasks",
    "candidates",
    "composition",
    "aggregation_policies",
    "objective"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["id", "name", "version", "created_at"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "task_id", "provider_id", "features"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "task_id": { "$ref": "#/$defs/identifier" },
          "provider_id": { "$ref": "#/$defs/identifier" },
          "name": { "type": "string", "minLength": 1 },
          "features": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "$ref": "#/$defs/identifier" },
            "additionalProperties": { "type": "number" }
          },
          "description": { "type": "string" }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "direction", "unit", "scale", "valid_range"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "name": { "type": "string", "minLength": 1 },
          "direction": {
            "type": "string",
            "enum": ["MAXIMIZE", "MINIMIZE"]
          },
          "unit": { "type": "string", "minLength": 1 },
          "scale": {
            "type": "string",
            "enum": ["RATIO", "INTERVAL", "ORDINAL"]
          },
          "valid_range": { "$ref": "#/$defs/numeric_range" },
          "description": { "type": "string" }
        }
      }
    },
    "composition": { "$ref": "#/$defs/structured_tree" },
    "aggregation_policies": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/aggregation_policy" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" },
      "default": []
    },
    "objective": { "$ref": "#/$defs/objective" },
    "resource_model": { "$ref": "#/$defs/resource_model" },
    "latency_model": { "$ref": "#/$defs/latency_model" }
  },
  "$defs": {
      "identifier": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "structured_tree": {
        "type": "object",
        "required": ["type", "root"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "STRUCTURED" },
          "root": { "$ref": "#/$defs/node" }
        }
      },
      "node": {
        "oneOf": [
          { "$ref": "#/$defs/task_node" },
          { "$ref": "#/$defs/seq_node" },
          { "$ref": "#/$defs/and_node" },
          { "$ref": "#/$defs/xor_node" },
          { "$ref": "#/$defs/loop_node" },
          { "$ref": "#/$defs/element_node" }
        ]
      },
      "task_node": {
        "type": "object",
        "required": ["id", "kind", "task_id"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "const": "TASK" },
          "task_id": { "$ref": "#/$defs/identifier" },
          "description": { "type": "string" }
        }
      },
      "element_node": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "const": "ELEMENT" },
          "description": { "type": "string" }
        }
      },
      "seq_node": {
        "type": "object",
        "required": ["id", "kind", "children"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "const": "SEQ" },
          "description": { "type": "string" },
          "children": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/$defs/node" }
          }
        }
      },
      "and_node": {
        "type": "object",
        "required": ["id", "kind", "children"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "const": "AND" },
          "description": { "type": "string" },
          "children": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/$defs/node" }
          }
        }
      },
      "xor_node": {
        "type": "object",
        "required": ["id", "kind", "branches"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "const": "XOR" },
          "description": { "type": "string" },
          "branches": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["p", "child"],
              "additionalProperties": false,
              "properties": {
                "p": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "child": { "$ref": "#/$defs/node" }
              }
            }
          }
        }
      },
      "loop_node": {
        "type": "object",
        "required": ["id", "kind", "body"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "const": "LOOP" },
          "description": { "type": "string" },
          "body": { "$ref": "#/$defs/node" },
          "expected_iterations": {
            "type": "number",
            "minimum": 0
          },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": { "type": "integer", "minimum": 0 },
              "max": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "allOf": [
          {
            "anyOf": [
              { "required": ["expected_iterations"] },
              { "required": ["bounds"] }
            ]
          }
        ]
      },
      "aggregation_policy": {
        "type": "object",
        "required": ["neutral", "compose"],
        "additionalProperties": false,
        "properties": {
          "neutral": { "type": "number" },
          "compose": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "seq": { "$ref": "#/$defs/compose_fn" },
              "and": { "$ref": "#/$defs/compose_fn" },
              "xor": { "$ref": "#/$defs/compose_fn" },
              "loop": { "$ref": "#/$defs/compose_fn" }
            },
            "anyOf": [
              { "required": ["seq"] },
              { "required": ["and"] },
              { "required": ["xor"] },
              { "required": ["loop"] }
            ]
          },
          "normalize": { "$ref": "#/$defs/normalization" }
        }
      },
      "normalization": {
        "$comment": "Declaring normalization for every objective target selects the canonical objective: a weighted mean of per-feature losses, where lower is better and the gateway value is authoritative over the one an engine reports. Instances that declare none keep the plain weighted sum of normalized goodness, where higher is better. The two are complements of each other when the weights sum to one.",
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["minmax", "identity"] },
          "bounds": { "$ref": "#/$defs/numeric_range" },
          "increasing_is_better": { "type": "boolean" }
        }
      },
      "compose_fn": {
        "type": "object",
        "required": ["fn"],
        "additionalProperties": false,
        "properties": {
          "fn": {
            "type": "string",
            "enum": [
              "SUM",
              "PRODUCT",
              "MAX",
              "MIN",
              "SCALED_SUM",
              "SCALED_PRODUCT",
              "SCALED_MIN",
              "SCALED_MAX",
              "MEAN",
              "WEIGHTED_SUM"
            ]
          }
        }
      },
      "constraint": {
        "oneOf": [
          { "$ref": "#/$defs/attr_bound_constraint" },
          { "$ref": "#/$defs/dependency_constraint" }
        ]
      },
      "attr_bound_constraint": {
        "type": "object",
        "required": ["id", "kind", "scope", "attribute_id", "op", "value"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "const": "ATTRIBUTE_BOUND" },
          "scope": {
            "type": "string",
            "enum": ["GLOBAL", "LOCAL"]
          },
          "tasks": {
            "type": "array",
            "items": { "$ref": "#/$defs/identifier" }
          },
          "candidates": {
            "type": "array",
            "items": { "$ref": "#/$defs/identifier" }
          },
          "attribute_id": { "$ref": "#/$defs/identifier" },
          "op": {
            "type": "string",
            "enum": ["<=", ">=", "==", "!=", "<", ">", "IN_RANGE"]
          },
          "value": {
            "oneOf": [{ "$ref": "#/$defs/numeric_range" }, { "type": "number" }]
          },
          "hard": { "type": "boolean", "default": true },
          "description": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "op": { "const": "IN_RANGE" } },
              "required": ["op"]
            },
            "then": {
              "properties": { "value": { "$ref": "#/$defs/numeric_range" } }
            }
          },
          {
            "if": {
              "properties": { "op": { "not": { "const": "IN_RANGE" } } },
              "required": ["op"]
            },
            "then": { "properties": { "value": { "type": "number" } } }
          },
          {
            "if": {
              "properties": { "scope": { "const": "LOCAL" } },
              "required": ["scope"]
            },
            "then": {
              "anyOf": [{ "required": ["tasks"] }, { "required": ["candidates"] }]
            }
          }
        ]
      },
      "dependency_constraint": {
        "type": "object",
        "required": ["id", "kind", "type", "tasks"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "const": "DEPENDENCY" },
          "type": {
            "type": "string",
            "enum": [
              "SAME_PROVIDER",
              "DIFFERENT_PROVIDER",
              "SAME_POOL",
              "DIFFERENT_POOL"
            ]
          },
          "tasks": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "hard": { "type": "boolean", "default": true },
          "description": { "type": "string" }
        }
      },
      "objective": {
        "oneOf": [
          { "$ref": "#/$defs/mono" },
          { "$ref": "#/$defs/multi" },
          { "$ref": "#/$defs/many" }
        ]
      },
      "weights": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": { "$ref": "#/$defs/identifier" },
        "additionalProperties": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "mono": {
        "type": "object",
        "required": ["type", "targets", "weights"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "MONO" },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "weights": { "$ref": "#/$defs/weights" },
          "weights_sum_to_one": { "type": "boolean", "default": true }
        }
      },
      "multi": {
        "type": "object",
        "required": ["type", "targets", "weights"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "MULTI" },
          "targets": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "weights": { "$ref": "#/$defs/weights" },
          "weights_sum_to_one": { "type": "boolean", "default": true }
        }
      },
      "many": {
        "type": "object",
        "required": ["type", "targets", "weights"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "MANY" },
          "targets": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "weights": { "$ref": "#/$defs/weights" },
          "weights_sum_to_one": { "type": "boolean", "default": true }
        }
      },
      "numeric_range": {
        "type": "object",
        "required": ["min", "max"],
        "additionalProperties": false,
        "properties": {
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      },

      "resource_model": {
        "$comment": "Placement extension, optional. An instance that omits resource_model and latency_model describes a plain binding problem; one that provides them adds resource and latency constraints over the very same decisions. Nothing else in the model changes either way.",
        "type": "object",
        "required": ["resources", "pools", "candidate_bindings", "constraints"],
        "additionalProperties": false,
        "properties": {
          "resources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "pools": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/resource_pool" }
          },
          "candidate_bindings": {
            "type": "array",
            "items": { "$ref": "#/$defs/candidate_resource_binding" }
          },
          "constraints": {
            "type": "array",
            "items": { "$ref": "#/$defs/resource_constraint" }
          }
        }
      },
      "resource_pool": {
        "type": "object",
        "required": ["id", "name", "kind", "capacity"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "$ref": "#/$defs/identifier" },
          "capacity": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/identifier" },
            "additionalProperties": { "type": "number", "minimum": 0 }
          },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "candidate_resource_binding": {
        "type": "object",
        "required": ["candidate_id", "pool_id", "demand"],
        "additionalProperties": false,
        "properties": {
          "candidate_id": { "$ref": "#/$defs/identifier" },
          "pool_id": { "$ref": "#/$defs/identifier" },
          "demand": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/identifier" },
            "additionalProperties": { "type": "number", "minimum": 0 }
          }
        }
      },
      "resource_constraint": {
        "type": "object",
        "required": ["id", "kind", "scope", "resources", "hard"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": {
            "type": "string",
            "enum": ["DEPENDENCY", "RESOURCE_CAPACITY"]
          },
          "type": { "const": "RESOURCE_CAPACITY" },
          "scope": {
            "type": "string",
            "enum": ["ALL_POOLS", "POOL_KIND"]
          },
          "resources": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "pool_kinds": {
            "type": "array",
            "items": { "$ref": "#/$defs/identifier" }
          },
          "hard": { "type": "boolean" }
        },
        "oneOf": [
          {
            "$comment": "Canonical form: resource capacity as a dependency-type constraint.",
            "properties": { "kind": { "const": "DEPENDENCY" } },
            "required": ["type"]
          },
          {
            "$comment": "Legacy spelling kept for backward compatibility.",
            "properties": { "kind": { "const": "RESOURCE_CAPACITY" } }
          }
        ]
      },
      "latency_model": {
        "type": "object",
        "required": [
          "unit",
          "pool_latency_matrix_ms",
          "event_generator_pools",
          "event_latency_matrix_ms",
          "transition_constraints",
          "global_latency"
        ],
        "additionalProperties": false,
        "properties": {
          "unit": { "const": "ms" },
          "pool_latency_matrix_ms": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/identifier" },
            "additionalProperties": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/identifier" },
              "additionalProperties": { "type": "number", "minimum": 0 }
            }
          },
          "event_generator_pools": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/identifier" },
            "additionalProperties": { "$ref": "#/$defs/identifier" }
          },
          "event_latency_matrix_ms": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/identifier" },
            "additionalProperties": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/identifier" },
              "additionalProperties": { "type": "number", "minimum": 0 }
            }
          },
          "transition_constraints": {
            "type": "array",
            "items": { "$ref": "#/$defs/latency_constraint" }
          },
          "global_latency": {
            "type": "object",
            "required": [
              "attribute_id",
              "include_execution_latency_feature",
              "xor_semantics",
              "and_semantics"
            ],
            "additionalProperties": false,
            "properties": {
              "attribute_id": { "$ref": "#/$defs/identifier" },
              "include_execution_latency_feature": { "type": "boolean" },
              "xor_semantics": {
                "type": "string",
                "enum": ["EXPECTED", "WORST_CASE"]
              },
              "and_semantics": {
                "type": "string",
                "enum": ["MAX", "SUM"]
              }
            }
          }
        }
      },
      "latency_constraint": {
        "type": "object",
        "required": ["id", "to_task", "op", "value", "hard"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "from_task": { "$ref": "#/$defs/identifier" },
          "from_event": { "$ref": "#/$defs/identifier" },
          "to_task": { "$ref": "#/$defs/identifier" },
          "op": {
            "type": "string",
            "enum": ["<=", "<", ">=", ">", "==", "IN_RANGE"]
          },
          "value": {
            "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/numeric_range" }]
          },
          "hard": { "type": "boolean" }
        },
        "oneOf": [
          { "required": ["from_task"] },
          { "required": ["from_event"] }
        ]
      }
    }
  }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbinding.score.us.es/api/v1/schemas/general",
  "title": "Compact QoS-Aware Service Composition",
  "description": "A binding problem instance, I' = (M_A, M'_C, Delta, O). Each element of the tuple is defined in its own file so that it can be reused on its own: the same application model over different infrastructures, or the same infrastructure under different objectives.",
  "type": "object",
  "required": [
    "metadata",
    "features",
    "providers",
    "tasks",
    "candidates",
    "composition",
    "aggregation_policies",
    "objective"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "providers": {
      "$ref": "candidate-model.schema.json#/properties/providers"
    },
    "tasks": {
      "$ref": "application-model.schema.json#/properties/tasks"
    },
    "candidates": {
      "$ref": "candidate-model.schema.json#/properties/candidates"
    },
    "features": {
      "$ref": "candidate-model.schema.json#/properties/features"
    },
    "composition": {
      "$ref": "application-model.schema.json#/properties/composition"
    },
    "aggregation_policies": {
      "$ref": "application-model.schema.json#/properties/aggregation_policies"
    },
    "constraints": {
      "$ref": "constraints.schema.json#/properties/constraints"
    },
    "objective": {
      "$ref": "objective.schema.json#/properties/objective"
    },
    "resource_model": {
      "$ref": "candidate-model.schema.json#/properties/resource_model"
    },
    "latency_model": {
      "$ref": "candidate-model.schema.json#/properties/latency_model"
    }
  }
}

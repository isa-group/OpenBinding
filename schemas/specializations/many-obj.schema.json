{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file:///Users/franciscojaviercaverolopez/Workspace/OpenBinding/schemas/specializations/many-obj.schema.json",
  "title": "Many-OBJ Specialization",
  "description": "Profile for the Many-OBJ Java Engine (structured workflows + weighted-sum objective + optional global attribute bounds).",
  "type": "object",
  "properties": {
    "composition": {
      "type": "object",
      "properties": {
        "type": { "const": "structured" },
        "root": { "$ref": "#/$defs/many_obj_node" }
      },
      "required": ["type", "root"]
    },
    "objective": {
      "properties": {
        "type": {
          "const": "weighted_sum"
        }
      },
      "required": [
        "type"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "attribute_bound"
          },
          "scope": {
            "const": "global"
          },
          "op": {
            "type": "string",
            "enum": [
              "<=",
              "<",
              ">=",
              ">",
              "==",
              "!="
            ]
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "kind",
          "scope",
          "op",
          "value"
        ]
      }
    }
  },
  "required": ["composition", "features", "aggregation_policies", "objective"],
  "$defs": {
    "many_obj_node": {
      "oneOf": [
        { "$ref": "#/$defs/task_node" },
        { "$ref": "#/$defs/seq_node" },
        { "$ref": "#/$defs/and_node" },
        { "$ref": "#/$defs/xor_node" },
        { "$ref": "#/$defs/loop_node" }
      ]
    },
    "task_node": {
      "type": "object",
      "properties": {
        "kind": { "const": "TASK" }
      },
      "required": ["kind"]
    },
    "seq_node": {
      "type": "object",
      "properties": {
        "kind": { "const": "SEQ" },
        "children": {
            "type": "array",
            "items": { "$ref": "#/$defs/many_obj_node" }
        }
      },
      "required": ["kind", "children"]
    },
    "and_node": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "AND"
        },
        "children": {
            "type": "array",
            "items": { "$ref": "#/$defs/many_obj_node" }
        }
      },
      "required": ["kind", "children"]
    },
    "xor_node": {
      "type": "object",
      "properties": {
        "kind": { "const": "XOR" },
        "branches": {
          "type": "array",
          "items": {
            "properties": {
              "child": {
                "$ref": "#/$defs/many_obj_node"
              },
              "p": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "child",
              "p"
            ]
          }
        }
      },
      "required": ["kind", "branches"]
    },
    "loop_node": {
      "type": "object",
      "properties": {
        "kind": { "const": "LOOP" },
        "body": { "$ref": "#/$defs/many_obj_node" },
        "expected_iterations": { "type": "number", "minimum": 0 }
      },
      "required": ["kind", "body", "expected_iterations"]
    }
  }
}

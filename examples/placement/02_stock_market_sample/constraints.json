{
  "apiVersion": "qos-binding/v1",
  "kind": "ConstraintSet",
  "metadata": {
    "name": "stock_market_placement_sample_constraints"
  },
  "spec": {
    "constraints": {
      "security_min_fBuy": {
        "assert": "tasks.fBuy.features.security >= 1.0",
        "enforcement": "hard"
      },
      "security_min_fBuyOrSell": {
        "assert": "tasks.fBuyOrSell.features.security >= 1.0",
        "enforcement": "hard"
      },
      "security_min_fCheck": {
        "assert": "tasks.fCheck.features.security >= 1.0",
        "enforcement": "hard"
      },
      "security_min_fRecord": {
        "assert": "tasks.fRecord.features.security >= 1.0",
        "enforcement": "hard"
      },
      "security_min_fSell": {
        "assert": "tasks.fSell.features.security >= 1.0",
        "enforcement": "hard"
      },
      "fCheck_requires_database": {
        "assert": "tasks.fCheck.features.has_service_database == 1",
        "enforcement": "hard"
      },
      "fRecord_requires_database": {
        "assert": "tasks.fRecord.features.has_service_database == 1",
        "enforcement": "hard"
      },
      "budget_global_stockOrch": {
        "assert": "features.cost <= 99.45059011",
        "enforcement": "hard"
      },
      "budget_local_fCheck": {
        "assert": "tasks.fCheck.features.cost <= 32.03485725",
        "enforcement": "hard"
      },
      "budget_local_fBuyOrSell": {
        "assert": "tasks.fBuyOrSell.features.cost <= 67.039127",
        "enforcement": "hard"
      },
      "budget_local_fSell": {
        "assert": "tasks.fSell.features.cost <= 24.65581241",
        "enforcement": "hard"
      },
      "budget_local_fBuy": {
        "assert": "tasks.fBuy.features.cost <= 20.50388885",
        "enforcement": "hard"
      },
      "budget_local_fRecord": {
        "assert": "tasks.fRecord.features.cost <= 50.05446445",
        "enforcement": "hard"
      }
    }
  }
}

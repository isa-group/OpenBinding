{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "small_placement_demo_optimization"
  },
  "spec": {
    "mode": "weighted",
    "terms": [
      {
        "feature": {
          "resource": "application",
          "id": "latency"
        },
        "weight": 0.4,
        "normalize": {
          "min": 0.0,
          "max": 100.0
        }
      },
      {
        "feature": {
          "resource": "application",
          "id": "cost"
        },
        "weight": 0.4,
        "normalize": {
          "min": 0.0,
          "max": 50.0
        }
      },
      {
        "feature": {
          "resource": "application",
          "id": "security"
        },
        "weight": 0.2,
        "normalize": {
          "min": 0.0,
          "max": 1.0
        }
      }
    ]
  }
}

{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "small_placement_demo_optimization"
  },
  "spec": {
    "criteria": [
      {
        "id": "latency",
        "feature": {
          "resource": "application",
          "id": "latency"
        },
        "normalize": {
          "min": 0,
          "max": 100
        }
      },
      {
        "id": "cost",
        "feature": {
          "resource": "application",
          "id": "cost"
        },
        "normalize": {
          "min": 0,
          "max": 50
        }
      },
      {
        "id": "security",
        "feature": {
          "resource": "application",
          "id": "security"
        },
        "normalize": {
          "min": 0,
          "max": 1
        }
      }
    ]
  }
}

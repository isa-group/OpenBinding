        },
        "normalize": {
          "min": 0,
          "max": 200,
          "clamp": true
        }
      },
      {
        "id": "latency",
        "feature": {
          "resource": "application",
          "id": "latency"
        },
        "normalize": {
          "min": 0,
          "max": 200,
          "clamp": true
        }
      },
      {
        "id": "quality",
        "feature": {
          "resource": "application",
          "id": "quality"
        },
        "normalize": {
          "min": 0,
          "max": 200,
          "clamp": true
        }
      }
    ]
  }
}

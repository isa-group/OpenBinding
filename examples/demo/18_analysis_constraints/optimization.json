{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "18_analysis_constraints_optimization"
  },
  "spec": {
    "penalties": [
      {
        "constraint": {
          "resource": "constraints",
          "id": "latency-sla"
        },
        "weight": 0.3

{
  "apiVersion": "qos-binding/v1",
  "kind": "ConstraintSet",
  "metadata": {
    "name": "18_analysis_constraints_constraints"
  },
  "spec": {
    "constraints": {
      "latency-sla": {
        "assert": "features.latency <= 100",
        "enforcement": "soft",
        "penalty": 1
      },
      "budget-cap": {
        "assert": "features.cost <= 160",
        "enforcement": "hard"
      }
    }
  }
}

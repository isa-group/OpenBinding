{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "fleet_routing_qaco_001_optimization"
  },
  "spec": {
    "mode": "weighted",
    "terms": [
      {
        "metric": {
          "resource": "application",
          "id": "cost"
        },
        "weight": 0.3,
        "normalize": {
          "min": 0,
          "max": 10000,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "execution_time"
        },
        "weight": 0.25,
        "normalize": {
          "min": 0,
          "max": 20000,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "availability"
        },
        "weight": 0.15,
        "normalize": {
          "min": 0.0,
          "max": 1.0,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "reliability"
        },
        "weight": 0.15,
        "normalize": {
          "min": 0.0,
          "max": 1.0,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "security"
        },
        "weight": 0.15,
        "normalize": {
          "min": 1,
          "max": 5,
          "clamp": true
        }
      }
    ]
  }
}

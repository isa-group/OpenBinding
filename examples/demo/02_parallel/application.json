{
  "apiVersion": "qos-binding/v1",
  "kind": "Application",
  "metadata": {
    "name": "demo_02_parallel_application"
  },
  "spec": {
    "tasks": {
      "t1": "service/t1",
      "t2": "service/t2"
    },
    "metrics": {
      "latency": {
        "unit": "ms",
        "direction": "minimize",
        "scope": "invocation",
        "aggregation": {
          "sequence": "sum",
          "parallel": "max",
          "exclusive": "weightedSum",
          "repeat": "scale",
          "selection": "sum"
        },
        "domain": {
          "kind": "real",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "workflow": {
      "parallel": [
        {
          "task": {
            "resource": "application",
            "id": "t1"
          }
        },
        {
          "task": {
            "resource": "application",
            "id": "t2"
          }
        }
      ]
    }
  }
}

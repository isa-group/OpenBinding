{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "demo_09_mixed_optimization"
  },
  "spec": {
    "criteria": [
      {
        "id": "rel",
        "feature": {
          "resource": "application",
          "id": "rel"
        },
        "normalize": {
          "min": 0,
          "max": 0.01,
          "clamp": true
        }
      },
      {
        "id": "cost",
        "feature": {
          "resource": "application",
          "id": "cost"
        },
        "normalize": {
          "min": 0,
          "max": 1000,
          "clamp": true
        }
      }
    ]
  }
}

{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "demo_09_mixed_optimization"
  },
  "spec": {
    "mode": "weighted",
    "terms": [
      {
        "metric": {
          "resource": "application",
          "id": "rel"
        },
        "weight": 0.8,
        "normalize": {
          "min": 0.0,
          "max": 0.01,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "cost"
        },
        "weight": 0.2,
        "normalize": {
          "min": 0,
          "max": 1000,
          "clamp": true
        }
      }
    ]
  }
}

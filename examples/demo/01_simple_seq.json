{
  "metadata": {
    "id": "demo_01_simple_seq",
    "name": "01. Simple Sequence",
    "version": "1.0.0",
    "created_at": "2026-02-10T12:00:00Z",
    "description": "A basic sequential composition of 3 tasks. This is the simplest possible workflow.",
    "level": "beginner"
  },
  "features": [
    {
      "id": "latency",
      "name": "Latency",
      "direction": "MINIMIZE",
      "unit": "ms",
      "scale": "RATIO",
      "valid_range": {"min": 0, "max": 1000}
    }
  ],
  "providers": [
    {"id": "p1", "name": "Provider 1"}
  ],
  "tasks": [
    {"id": "t1", "name": "Task 1"},
    {"id": "t2", "name": "Task 2"},
    {"id": "t3", "name": "Task 3"}
  ],
  "candidates": [
    {"id": "c1a", "task_id": "t1", "provider_id": "p1", "name": "Service 1A", "features": {"latency": 10}},
    {"id": "c1b", "task_id": "t1", "provider_id": "p1", "name": "Service 1B", "features": {"latency": 20}},
    {"id": "c2a", "task_id": "t2", "provider_id": "p1", "name": "Service 2A", "features": {"latency": 15}},
    {"id": "c3a", "task_id": "t3", "provider_id": "p1", "name": "Service 3A", "features": {"latency": 5}}
  ],
  "composition": {
    "type": "STRUCTURED",
    "root": {
      "id": "root",
      "kind": "SEQ",
      "children": [
        {"id": "n1", "kind": "TASK", "task_id": "t1"},
        {"id": "n2", "kind": "TASK", "task_id": "t2"},
        {"id": "n3", "kind": "TASK", "task_id": "t3"}
      ]
    }
  },
  "aggregation_policies": {
    "latency": {
      "neutral": 0,
      "compose": {
        "seq": {"fn": "SUM"},
        "and": {"fn": "MAX"},
        "loop": {"fn": "SCALED_SUM"}
      }
    }
  },
  "objective": {
    "type": "SINGLE",
    "targets": ["latency"],
    "weights": {"latency": 1.0}
  }
}

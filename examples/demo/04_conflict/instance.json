{
  "apiVersion": "bim/v1",
  "kind": "Instance",
  "metadata": {
    "name": "demo_04_conflict",
    "version": "1.0.0",
    "description": "An example where constraints make a solution impossible. All candidates have non-negative cost, but we constrain globally to cost < 0.",
    "annotations": {
      "level": "intermediate"
    }
  },
  "spec": {
    "profile": "qos-binding/v1",
    "resources": {
      "application": {
        "application": "application.json"
      },
      "candidateCatalog": {
        "catalog": "candidates.json"
      },
      "optimization": {
        "optimization": "optimization.json"
      },
      "constraintSet": {
        "constraints": "constraints.json"
      }
    }
  }
}

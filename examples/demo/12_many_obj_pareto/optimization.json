{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "demo_many_obj_optimization"
  },
  "spec": {
    "criteria": [
      {
        "id": "cost",
        "feature": {
          "resource": "application",
          "id": "cost"
        },
        "normalize": {
          "min": 0,
          "max": 100,
          "clamp": true
        }
      },
      {
        "id": "time",
        "feature": {
          "resource": "application",
          "id": "time"
        },
        "normalize": {
          "min": 0,
          "max": 100,
          "clamp": true
        }
      },
      {
        "id": "reliability",
        "feature": {
          "resource": "application",
          "id": "reliability"
        },
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      }
    ]
  }
}

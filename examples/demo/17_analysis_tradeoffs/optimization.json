{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "17_analysis_tradeoffs_optimization"
  },
  "spec": {
    "mode": "pareto",
    "type": "MULTI",
    "terms": [
      {
        "feature": {
          "resource": "application",
          "id": "cost"
        },
        "weight": 1,
        "normalize": {
          "min": 0,
          "max": 200,
          "clamp": true
        }
      },
      {
        "feature": {
          "resource": "application",
          "id": "latency"
        },
        "weight": 1,
        "normalize": {
          "min": 0,
          "max": 200,
          "clamp": true
        }
      }
    ]
  }
}

{
  "apiVersion": "qos-binding/v1",
  "kind": "ConstraintSet",
  "metadata": {
    "name": "demo_15_bpmn_complete_constraints",
    "description": "Global service levels plus a task-local latency check and provider separation rule."
  },
  "spec": {
    "constraints": {
      "end_to_end_latency": {
        "assert": "features.latency <= 220",
        "enforcement": "hard"
      },
      "run_budget": {
        "assert": "features.cost <= 30",
        "enforcement": "hard"
      },
      "carbon_budget": {
        "assert": "features.carbon <= 30",
        "enforcement": "hard"
      },
      "trust_floor": {
        "assert": "features.trust >= 0.85",
        "enforcement": "hard"
      },
      "authentication_response": {
        "assert": "tasks.authenticate.features.latency <= 9",
        "enforcement": "hard"
      },
      "edge_authentication": {
        "assert": "tasks.authenticate.provider.id == 'edge-labs'",
        "enforcement": "hard"
      }
    }
  }
}

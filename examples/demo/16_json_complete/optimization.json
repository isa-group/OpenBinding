{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "demo_15_bpmn_complete_optimization",
    "description": "One utility over four normalized service-level dimensions."
  },
  "spec": {
    "criteria": [
      {
        "id": "latency",
        "feature": {
          "resource": "application",
          "id": "latency"
        },
        "normalize": {
          "min": 0,
          "max": 220,
          "clamp": true
        }
      },
      {
        "id": "cost",
        "feature": {
          "resource": "application",
          "id": "cost"
        },
        "normalize": {
          "min": 0,
          "max": 30,
          "clamp": true
        }
      },
      {
        "id": "carbon",
        "feature": {
          "resource": "application",
          "id": "carbon"
        },
        "normalize": {
          "min": 0,
          "max": 30,
          "clamp": true
        }
      },
      {
        "id": "trust",
        "feature": {
          "resource": "application",
          "id": "trust"
        },
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      }
    ]
  }
}

{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "demo_14_shared_candidates_optimization"
  },
  "spec": {
    "criteria": [
      {
        "id": "cost",
        "feature": {
          "resource": "application",
          "id": "cost"
        },
        "normalize": {
          "min": 0,
          "max": 30,
          "clamp": true
        }
      },
      {
        "id": "latency",
        "feature": {
          "resource": "application",
          "id": "latency"
        },
        "normalize": {
          "min": 0,
          "max": 90,
          "clamp": true
        }
      }
    ]
  }
}

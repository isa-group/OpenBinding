      "valid_range": {"min": 0, "max": 1000}
    }
  ],
  "providers": [{"id": "p1", "name": "P1"}],
  "tasks": [{"id": "t1", "name": "Task 1"}],
  "candidates": [
    {"id": "c1", "task_id": "t1", "provider_id": "p1", "name": "Fast (Valid)", "features": {"latency": 40}},
    {"id": "c2", "task_id": "t1", "provider_id": "p1", "name": "Slow (Soft Violation)", "features": {"latency": 60}}
  ],
  "composition": {
    "type": "STRUCTURED",
    "root": {"id": "n1", "kind": "TASK", "task_id": "t1"}

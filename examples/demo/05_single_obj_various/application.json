{
  "apiVersion": "qos-binding/v1",
  "kind": "Application",
  "metadata": {
    "name": "demo_05_multi_obj_application"
  },
  "spec": {
    "tasks": {
      "t1": "service/t1"
    },
    "metrics": {
      "cost": {
        "unit": "eur",
        "direction": "minimize",
        "scope": "invocation",
        "aggregation": "sum",
        "domain": {
          "kind": "real",
          "minimum": 0,
          "maximum": 100
        }
      },
      "latency": {
        "unit": "ms",
        "direction": "minimize",
        "scope": "invocation",
        "aggregation": {
          "sequence": "sum",
          "parallel": "max",
          "exclusive": "weightedSum",
          "repeat": "scale",
          "selection": "sum"
        },
        "domain": {
          "kind": "real",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "workflow": {
      "task": {
        "resource": "application",
        "id": "t1"
      }
    }
  }
}

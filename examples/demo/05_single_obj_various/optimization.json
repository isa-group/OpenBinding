{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "demo_05_multi_obj_optimization"
  },
  "spec": {
    "mode": "weighted",
    "terms": [
      {
        "feature": {
          "resource": "application",
          "id": "cost"
        },
        "weight": 0.5,
        "normalize": {
          "min": 0,
          "max": 100,
          "clamp": true
        }
      },
      {
        "feature": {
          "resource": "application",
          "id": "latency"
        },
        "weight": 0.5,
        "normalize": {
          "min": 0,
          "max": 100,
          "clamp": true
        }
      }
    ]
  }
}

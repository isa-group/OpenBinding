    "annotations": {
      "level": "intermediate"
    }
  },
  "spec": {
    "profile": "qos-binding/v1",
    "resources": {
      "application": {
        "application": "application.json"
      },
      "candidateCatalog": {
        "catalog": "candidates.json"
      },
      "optimization": {
        "optimization": "optimization.json"
      },
      "constraintSet": {
        "constraints": "constraints.json"
      }
    }
  }
}

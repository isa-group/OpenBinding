{
  "apiVersion": "qos-binding/v1",
  "kind": "Application",
  "metadata": {
    "name": "demo_15_bpmn_complete_application",
    "description": "Seven service tasks whose executable control flow is defined by the BPMN resource."
  },
  "spec": {
    "tasks": {
      "authenticate": "service/authenticate",
      "enrich": "service/enrich",
      "cache": "service/cache",
      "fetch": "service/fetch",
      "score": "service/score",
      "audit": "service/audit",
      "publish": "service/publish"
    },
    "metrics": {
      "latency": {
        "unit": "ms",
        "direction": "minimize",
        "scope": "invocation",
        "aggregation": {
          "sequence": "sum",
          "parallel": "max",
          "exclusive": "weightedSum",
          "repeat": "scale",
          "selection": "sum"
        },
        "domain": {
          "kind": "real",
          "minimum": 0,
          "maximum": 500
        }
      },
      "cost": {
        "unit": "EUR/run",
        "direction": "minimize",
        "scope": "selectedCandidate",
        "aggregation": "sum",
        "domain": {
          "kind": "real",
          "minimum": 0,
          "maximum": 100
        }
      },
      "carbon": {
        "unit": "gCO2e/run",
        "direction": "minimize",
        "scope": "selectedCandidate",
        "aggregation": "sum",
        "domain": {
          "kind": "real",
          "minimum": 0,
          "maximum": 100
        }
      },
      "trust": {
        "unit": "1",
        "direction": "maximize",
        "scope": "selectedCandidate",
        "aggregation": "min",
        "domain": {
          "kind": "ratio"
        }
      }
    },
    "workflow": {
      "bpmn": {
        "resource": "workflow",
        "id": "Process_Fulfillment"
      }
    }
  }
}

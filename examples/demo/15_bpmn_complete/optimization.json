{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "demo_15_bpmn_complete_optimization",
    "description": "One utility over four normalized service-level dimensions."
  },
  "spec": {
    "mode": "weighted",
    "type": "MONO",
    "terms": [
      {
        "metric": {"resource": "application", "id": "latency"},
        "weight": 0.45,
        "normalize": {"min": 0, "max": 220, "clamp": true}
      },
      {
        "metric": {"resource": "application", "id": "cost"},
        "weight": 0.25,
        "normalize": {"min": 0, "max": 30, "clamp": true}
      },
      {
        "metric": {"resource": "application", "id": "carbon"},
        "weight": 0.15,
        "normalize": {"min": 0, "max": 30, "clamp": true}
      },
      {
        "metric": {"resource": "application", "id": "trust"},
        "weight": 0.15,
        "normalize": {"min": 0, "max": 1, "clamp": true}
      }
    ]
  }
}

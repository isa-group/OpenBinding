{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "demo_10_large_scale_optimization"
  },
  "spec": {
    "criteria": [
      {
        "id": "cost",
        "feature": {
          "resource": "application",
          "id": "cost"
        },
        "normalize": {
          "min": 0,
          "max": 1000,
          "clamp": true
        }
      },
      {
        "id": "time",
        "feature": {
          "resource": "application",
          "id": "time"
        },
        "normalize": {
          "min": 0,
          "max": 5000,
          "clamp": true
        }
      },
      {
        "id": "reliability",
        "feature": {
          "resource": "application",
          "id": "reliability"
        },
        "normalize": {
          "min": 0.005,
          "max": 0.01,
          "clamp": true
        }
      },
      {
        "id": "reputation",
        "feature": {
          "resource": "application",
          "id": "reputation"
        },
        "normalize": {
          "min": 0,
          "max": 10,
          "clamp": true
        }
      }
    ]
  }
}

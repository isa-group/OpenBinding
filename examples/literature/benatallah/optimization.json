{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "benatallah2002_selfserv_travel_solution_cts_itas_optimization"
  },
  "spec": {
    "mode": "weighted",
    "terms": [
      {
        "metric": {
          "resource": "application",
          "id": "cost_usd"
        },
        "weight": 0.28,
        "normalize": {
          "min": 0,
          "max": 5000,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "latency_ms"
        },
        "weight": 0.21,
        "normalize": {
          "min": 0,
          "max": 10000,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "availability"
        },
        "weight": 0.21,
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "reliability"
        },
        "weight": 0.15,
        "normalize": {
          "min": 0.0,
          "max": 1.0,
          "clamp": true
        }
      },
      {
        "metric": {
          "resource": "application",
          "id": "security"
        },
        "weight": 0.15,
        "normalize": {
          "min": 1,
          "max": 5,
          "clamp": true
        }
      }
    ]
  }
}

{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "zhang2014_entertainment_planner_running_example_optimization"
  },
  "spec": {
    "penalties": [
      {
        "constraint": {
          "resource": "constraints",
          "id": "c_time_budget"
        },
        "weight": 1
      },
      {
        "constraint": {
          "resource": "constraints",
          "id": "c_cost_budget"
        },
        "weight": 1
      }
    ],
    "criteria": [
      {
        "id": "cost",
        "feature": {
          "resource": "application",
          "id": "cost"
        },
        "normalize": {
          "min": 0,
          "max": 1000,
          "clamp": true
        }
      },
      {
        "id": "time",
        "feature": {
          "resource": "application",
          "id": "time"
        },
        "normalize": {
          "min": 0,
          "max": 1440,
          "clamp": true
        }
      },
      {
        "id": "availability",
        "feature": {
          "resource": "application",
          "id": "availability"
        },
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "id": "reliability",
        "feature": {
          "resource": "application",
          "id": "reliability"
        },
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "id": "security",
        "feature": {
          "resource": "application",
          "id": "security"
        },
        "normalize": {
          "min": 1,
          "max": 5,
          "clamp": true
        }
      },
      {
        "id": "distance",
        "feature": {
          "resource": "application",
          "id": "distance"
        },
        "normalize": {
          "min": 0,
          "max": 50000,
          "clamp": true
        }
      }
    ]
  }
}

{
  "application.json": {
    "apiVersion": "qos-binding/v1",
    "kind": "Application",
    "metadata": {
      "name": "email-set-a-application"
    },
    "spec": {
      "features": {
        "subscription": {
          "aggregation": "sum",
          "direction": "minimize",
          "domain": {
            "kind": "real",
            "maximum": 500,
            "minimum": 0
          },
          "scope": "selectedCandidate",
          "unit": "USD/month"
        }
      },
      "tasks": {
        "send": {
          "requires": {
            "predicate": "candidate.properties.emailsPerMonth >= 30000",
            "type": "service/email"
          }
        }
      },
      "workflow": {
        "sequence": [
          {
            "task": {
              "id": "send",
              "resource": "application"
            }
          }
        ]
      }
    }
  },
  "instance.json": {
    "apiVersion": "bim/v1",
    "kind": "Instance",
    "metadata": {
      "annotations": {
        "openbinding.org/sphere-recipe": "sha256-2ba62bcbaf5742431440257bedc906dbe1b05b4a0acd474abd229735ccb5dd6a"
      },
      "name": "email-set-a"
    },
    "spec": {
      "profile": "qos-binding/v1",
      "resources": {
        "application": {
          "application": "application.json"
        },
        "candidateCatalog": {
          "sphere-email": "sphere-email.json"
        },
        "optimization": {
          "optimization": "optimization.json"
        }
      }
    }
  },
  "optimization.json": {
    "apiVersion": "qos-binding/v1",
    "kind": "Optimization",
    "metadata": {
      "name": "email-set-a-optimization"
    },
    "spec": {
      "criteria": [
        {
          "feature": {
            "id": "subscription",
            "resource": "application"
          },
          "id": "subscription",
          "normalize": {
            "clamp": true,
            "max": 500,
            "min": 0
          }
        }
      ]
    }
  },

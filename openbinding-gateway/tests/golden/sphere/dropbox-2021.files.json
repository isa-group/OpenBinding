{
  "application.json": {
    "apiVersion": "qos-binding/v1",
    "kind": "Application",
    "metadata": {
      "name": "dropbox-application"
    },
    "spec": {
      "features": {
        "subscription": {
          "aggregation": "sum",
          "direction": "minimize",
          "domain": {
            "kind": "real",
            "maximum": 20,
            "minimum": 0
          },
          "scope": "selectedCandidate",
          "unit": "USD/month"
        }
      },
      "tasks": {
        "export": "service/storage"
      },
      "workflow": {
        "sequence": [
          {
            "task": {
              "id": "export",
              "resource": "application"
            }
          }
        ]
      }
    }
  },
  "instance.json": {
    "apiVersion": "bim/v1",
    "kind": "Instance",
    "metadata": {
      "annotations": {
        "openbinding.org/sphere-recipe": "sha256-4b5b58eb977309137df978c045503829f53f7925f1e3734502d3146c091a456f"
      },
      "name": "dropbox"
    },
    "spec": {
      "profile": "qos-binding/v1",
      "resources": {
        "application": {
          "application": "application.json"
        },
        "candidateCatalog": {
          "sphere-storage": "sphere-storage.json"
        },
        "optimization": {
          "optimization": "optimization.json"
        }
      }
    }
  },
  "optimization.json": {
    "apiVersion": "qos-binding/v1",
    "kind": "Optimization",
    "metadata": {
      "name": "dropbox-optimization"
    },
    "spec": {
      "criteria": [
        {
          "feature": {
            "id": "subscription",
            "resource": "application"
          },
          "id": "subscription",
          "normalize": {
            "clamp": true,
            "max": 20,
            "min": 0
          }
        }
      ]
    }
  },

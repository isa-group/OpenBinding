{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbinding.dev/schema/composition2yaml/v1/composition.schema.json",
  "title": "Composition2Yaml v1",
  "description": "A composition: the central entity of OpenBinding Studio. Defined by its translation into qos-binding/v1 documents, specified in docs/COMPOSITION2YAML.md.",
  "type": "object",
  "required": [
    "composition",
    "version",
    "properties",
    "tasks",
    "workflow"
  ],
  "additionalProperties": false,
  "properties": {
    "composition": {
      "$ref": "#/$defs/name"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pricing": {
      "$ref": "#/$defs/pricing"
    },
    "properties": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/symbol"
      },
      "additionalProperties": {
        "$ref": "#/$defs/property"
      }
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/symbol"
      },
      "additionalProperties": {
        "$ref": "#/$defs/task"
      }
    },
    "workflow": {
      "$ref": "#/$defs/node"
    },
    "candidates": {
      "$ref": "#/$defs/candidates"
    },
    "placement": {
      "$ref": "#/$defs/placement"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/goal"
      }
    },
    "studio": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "real",
            "integer",
            "ratio"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "enum": [
            "sum",
            "product",
            "min",
            "max"
          ]
        },
        "parallel": {
          "enum": [
            "sum",
            "product",
            "min",
            "max"
          ]
        },
        "exclusive": {
          "enum": [
            "weightedSum",
            "weightedProduct",
            "min",
            "max"
          ]
        },
        "repeat": {
          "enum": [
            "scale",
            "power",
            "identity"
          ]
        },
        "selection": {
          "enum": [
            "sum",
            "product",
            "min",
            "max"
          ]
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": {
          "enum": [
            "cost",
            "latency",
            "availability",
            "reliability",
            "throughput"
          ]
        },
        "title": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "minimize",
            "maximize"
          ]
        },
        "scope": {
          "enum": [
            "invocation",
            "selectedCandidate"
          ]
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "aggregate": {
          "$ref": "#/$defs/aggregate"
        },
        "neutral": {
          "type": "number"
        },
        "applies_to": {
          "enum": [
            "all",
            "classical",
            "quantum"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "template"
          ]
        },
        {
          "required": [
            "direction",
            "aggregate"
          ]
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "open": {
          "const": true
        },
        "requires": {
          "type": "string",
          "minLength": 1
        },
        "fixed": {
          "$ref": "#/$defs/fixedTask"
        },
        "local": {
          "const": true
        },
        "title": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "open",
            "requires"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fixed"
                ]
              },
              {
                "required": [
                  "local"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "fixed"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "open"
                ]
              },
              {
                "required": [
                  "local"
                ]
              },
              {
                "required": [
                  "requires"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "local"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "open"
                ]
              },
              {
                "required": [
                  "fixed"
                ]
              },
              {
                "required": [
                  "requires"
                ]
              }
            ]
          }
        }
      ]
    },
    "fixedTask": {
      "type": "object",
      "required": [
        "properties"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/symbol"
        },
        "properties": {
          "$ref": "#/$defs/propertyValues"
        },
        "domain": {
          "description": "Which kind of solver this is, matched against a property's applies_to. A Studio concept with no counterpart in the container: it decides where section 10.2's neutral is substituted.",
          "enum": [
            "all",
            "classical",
            "quantum"
          ]
        }
      }
    },
    "propertyValues": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/symbol"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": {
          "$ref": "#/$defs/symbol"
        },
        "empty": {
          "const": true
        },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "parallel": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "exclusive": {
          "$ref": "#/$defs/exclusive"
        },
        "repeat": {
          "$ref": "#/$defs/repeat"
        }
      },
      "oneOf": [
        {
          "required": [
            "task"
          ]
        },
        {
          "required": [
            "empty"
          ]
        },
        {
          "required": [
            "sequence"
          ]
        },
        {
          "required": [
            "parallel"
          ]
        },
        {
          "required": [
            "exclusive"
          ]
        },
        {
          "required": [
            "repeat"
          ]
        }
      ]
    },
    "exclusive": {
      "type": "object",
      "required": [
        "id",
        "branches"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbol"
        },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/branch"
          }
        },
        "distribution": {
          "const": "uniform"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "distribution"
            ]
          },
          "then": {
            "properties": {
              "branches": {
                "items": {
                  "not": {
                    "required": [
                      "probability"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "branch": {
      "type": "object",
      "required": [
        "flow"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbol"
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flow": {
          "$ref": "#/$defs/node"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repeat": {
      "type": "object",
      "required": [
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/node"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "expected": {
          "type": "number",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "required": [
            "count"
          ],
          "not": {
            "required": [
              "expected"
            ]
          }
        },
        {
          "required": [
            "expected"
          ],
          "not": {
            "required": [
              "count"
            ]
          }
        }
      ]
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/symbol"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "properties": {
                "type": "object",
                "description": "A free-form map of scalars, the container's own properties map rather than the numeric features this surface calls properties.",
                "propertyNames": {
                  "$ref": "#/$defs/symbol"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "id",
        "provides",
        "properties"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbol"
        },
        "provides": {
          "description": "One capability type, or several. The list is visible in the IR in its order and its multiplicity, so it is never sorted and never deduplicated.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "provider": {
          "$ref": "#/$defs/symbol"
        },
        "title": {
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/propertyValues"
        },
        "domain": {
          "description": "Which kind of solver this is, matched against a property's applies_to. A Studio concept with no counterpart in the container: it decides where section 10.2's neutral is substituted.",
          "enum": [
            "all",
            "classical",
            "quantum"
          ]
        },
        "attributes": {
          "type": "object",
          "description": "A free-form map of scalars, the container's own properties map rather than the numeric features this surface calls properties.",
          "propertyNames": {
            "$ref": "#/$defs/symbol"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "placement": {
          "type": "object",
          "description": "Where this candidate runs. Written per candidate even when the document that produced it used a group or a defaults block: both are erased by the lowering, and expanding them here is what makes the demand a property of the candidate rather than of the way it was written.",
          "required": [
            "pool"
          ],
          "additionalProperties": false,
          "properties": {
            "pool": {
              "$ref": "#/$defs/symbol"
            },
            "resources": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/symbol"
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "assert"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbol"
        },
        "assert": {
          "type": "string",
          "minLength": 1
        },
        "enforcement": {
          "enum": [
            "hard",
            "soft"
          ]
        },
        "penalty": {
          "type": "number",
          "minimum": 0
        },
        "weight": {
          "description": "How the optimization weighs this rule's penalty, which is a second number independent of the penalty itself: the gate's soft constraints all charge 1 while two are weighed 0.3 and three carry no weight at all. Omit it to write none.",
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enforcement": {
                "const": "soft"
              }
            },
            "required": [
              "enforcement"
            ]
          },
          "then": {
            "required": [
              "penalty"
            ]
          },
          "else": {
            "not": {
              "required": [
                "penalty"
              ]
            }
          }
        }
      ]
    },
    "goal": {
      "type": "object",
      "required": [
        "property"
      ],
      "additionalProperties": false,
      "properties": {
        "property": {
          "$ref": "#/$defs/symbol"
        },
        "normalize": {
          "type": "object",
          "description": "The range this criterion scales the property onto, when it is not the property's domain. A criterion's range is an independent number in the IR and 14 corpus packages use that independence; widening the domain to match is not a way out, because the domain is in the IR too. Omitted, the range is the property's domain.",
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "clamp": {
              "type": "boolean",
              "default": true,
              "description": "Whether a value outside the range is pulled to the nearer bound. The container's own default is false, so writing false here reproduces a criterion that omits the key; 8 of the gate's 266 criteria do."
            }
          }
        }
      }
    },
    "pricing": {
      "description": "The permanent link to one immutable SPHERE pricing version. A bare string is the shorthand for href; the version is read from the link and is never a separate field.",
      "oneOf": [
        {
          "$ref": "#/$defs/httpsUrl"
        },
        {
          "type": "object",
          "required": [
            "href"
          ],
          "additionalProperties": false,
          "properties": {
            "href": {
              "$ref": "#/$defs/httpsUrl"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256-[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "pool": {
      "type": "object",
      "required": [
        "id",
        "capacity"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbol"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "default": "generic"
        },
        "name": {
          "type": "string"
        },
        "capacity": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/symbol"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "properties": {
          "type": "object",
          "description": "A free-form map of scalars, the container's own properties map rather than the numeric features this surface calls properties.",
          "propertyNames": {
            "$ref": "#/$defs/symbol"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "networkEdge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "latency"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/symbol"
        },
        "to": {
          "$ref": "#/$defs/symbol"
        },
        "latency": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "pool"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbol"
        },
        "pool": {
          "$ref": "#/$defs/symbol"
        },
        "latency": {
          "type": "array",
          "description": "Ordered: the list is visible in the IR in its order, so it is never sorted.",
          "items": {
            "type": "object",
            "required": [
              "pool",
              "latency"
            ],
            "additionalProperties": false,
            "properties": {
              "pool": {
                "$ref": "#/$defs/symbol"
              },
              "latency": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbol"
        },
        "from": {
          "description": "A task, named directly, or an event named as {event: id}.",
          "oneOf": [
            {
              "$ref": "#/$defs/symbol"
            },
            {
              "type": "object",
              "required": [
                "event"
              ],
              "additionalProperties": false,
              "properties": {
                "event": {
                  "$ref": "#/$defs/symbol"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "task"
              ],
              "additionalProperties": false,
              "properties": {
                "task": {
                  "$ref": "#/$defs/symbol"
                }
              }
            }
          ]
        },
        "to": {
          "description": "A task, named directly, or an event named as {event: id}.",
          "oneOf": [
            {
              "$ref": "#/$defs/symbol"
            },
            {
              "type": "object",
              "required": [
                "event"
              ],
              "additionalProperties": false,
              "properties": {
                "event": {
                  "$ref": "#/$defs/symbol"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "task"
              ],
              "additionalProperties": false,
              "properties": {
                "task": {
                  "$ref": "#/$defs/symbol"
                }
              }
            }
          ]
        },
        "feature": {
          "$ref": "#/$defs/symbol",
          "default": "latency"
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "capacityRule": {
      "type": "object",
      "description": "Which resources are counted against a pool's capacity. The position of the rule in the list is data in the container, so the list order is kept.",
      "required": [
        "resources"
      ],
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "scope": {
          "enum": [
            "selectedCandidate",
            "invocation"
          ],
          "default": "selectedCandidate"
        }
      }
    },
    "placement": {
      "type": "object",
      "description": "Where the candidates run, and what the network between the pools costs. A document may write a symmetric network and a defaults or groups block; both are conveniences the lowering erases, so this surface writes what they expand to.",
      "required": [
        "pools"
      ],
      "additionalProperties": false,
      "properties": {
        "pools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pool"
          }
        },
        "network": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/networkEdge"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "capacityRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capacityRule"
          }
        },
        "globalLatency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "feature": {
              "$ref": "#/$defs/symbol",
              "default": "latency"
            },
            "includeExecution": {
              "type": "boolean",
              "default": true
            },
            "exclusive": {
              "enum": [
                "routing",
                "condition"
              ],
              "default": "routing"
            },
            "parallel": {
              "enum": [
                "max",
                "sum"
              ],
              "default": "max"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "A candidate's placement names a pool, and the pools live in the top-level placement block. Without it the demand has no destination in any emitted document, so the composition would compile and mean something else. The text layer refuses the same shape with a message that names the candidate; this is here so an editor validating against the schema alone refuses it too.",
      "if": {
        "required": [
          "candidates"
        ],
        "properties": {
          "candidates": {
            "required": [
              "rows"
            ],
            "properties": {
              "rows": {
                "contains": {
                  "required": [
                    "placement"
                  ]
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "placement"
        ]
      }
    }
  ]
}

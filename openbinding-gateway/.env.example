# Where each engine answers. The defaults in registry/engine.py are the
# compose service names, so these only need setting when running the gateway
# outside the stack.
ENGINE_MINIZINC_URL=http://localhost:3000
ENGINE_RANDOM_SEARCH_URL=http://localhost:8080
ENGINE_MANY_HEURISTIC_URL=http://localhost:8081
ENGINE_EVOLUTIONARY_HEURISTICS_URL=http://localhost:8082

# The general schema and the directory holding the specialization schemas.
# The general schema is split one file per element of the tuple; this points
# at the root document, and its siblings are read from the same directory.
GENERAL_SCHEMA_PATH=../schemas/general/schema.json
SCHEMAS_DIR=../schemas

# How long the gateway waits for an engine before giving up.
ENGINE_SOLVE_TIMEOUT_S=1800

# Browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

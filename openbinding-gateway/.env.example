# Every variable the gateway reads is declared in core/settings.py; this file
# lists them with the values a local run wants.

# Where each engine answers. The defaults in settings are the compose service
# names, so these only need setting when running the gateway outside the stack.
ENGINE_MINIZINC_URL=http://localhost:3000
ENGINE_RANDOM_SEARCH_URL=http://localhost:8080
ENGINE_MANY_HEURISTIC_URL=http://localhost:8081
ENGINE_EVOLUTIONARY_HEURISTICS_URL=http://localhost:8082

# Root containing the BIM v1 schemas, manifests, and engine protocol contract.
SCHEMAS_DIR=../schemas

# How long the gateway waits for an engine before giving up. Keep nginx's
# proxy_read_timeout above this, or long synchronous solves die at the edge.
ENGINE_SOLVE_TIMEOUT_S=1800

# Jobs. MAX_CONCURRENT_JOBS_PER_USER is the queued plus running jobs one account
# may have at once (minimum 1); a creation past it is refused with 429
# concurrency_limit_exceeded. A technical limit that protects the engines,
# independent of the plan. QUEUE_TIMEOUT_S is how long a job may wait in the queue
# without a worker claiming it before the reconciler fails it with queue_timeout
# (minimum 60, counted from when it was queued, whatever budget it was given).
# Values below are the defaults.
MAX_CONCURRENT_JOBS_PER_USER=8
QUEUE_TIMEOUT_S=1800
# Every request to a federated engine carries two hints, not part of
# bim-engine/v1 and not configurable: X-Openbinding-Job-Id (the gateway job) and
# X-Openbinding-Attempt (which attempt this is). An engine can use them to
# recognise a redelivered or repeated submission of the same job; one that
# ignores them may run the work twice.

# Browser origins allowed to call the API: a CLOSED, comma-separated list, with
# no wildcard (the session tokens live in the browser's localStorage). The value
# below is also the default: the frontend's Vite dev server (5173) and the
# Playwright server (4177). With APP_ENV=prod an empty list or a `*` entry makes
# the gateway refuse to start, so a production deployment must name its frontend
# origin(s) exactly, e.g. CORS_ALLOW_ORIGINS=https://openbinding.example.org
# A wildcard in development disables credentialed requests, whatever
# CORS_ALLOW_CREDENTIALS says: browsers reject that combination.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4177,http://127.0.0.1:4177
CORS_ALLOW_CREDENTIALS=false
# Exposed to the browser on every response (not configurable): Retry-After, ETag,
# Location, Content-Disposition, Digest, Idempotency-Key.

# Billing-sponsor proposals wait this many days for the proposed person's answer
# before they expire (docs/ACCOUNTS_AND_PLANS.md).
SPONSOR_PROPOSAL_TTL_DAYS=14
# Reads of other people's public projects (docs/ACCESS_POLICY.md) are limited per
# caller and per minute; 0 switches the limit off. Members are not limited.
PUBLIC_READ_RATE_PER_MINUTE=240

# Where the CAS callback sends the browser afterwards (/auth/cas/callback?code=...
# or ?error=<code>). It is read from here and never from the request, so the
# redirect cannot be turned into an open redirect.
FRONTEND_URL=http://localhost:5173

# Accounts and sessions. Unset DATABASE_URL means the user module is not in
# play. GATEWAY_JWT_SECRET has no default on purpose: a well-known signing key
# is worse than a missing one.
# DATABASE_URL=postgresql+asyncpg://openbinding:openbinding@postgres:5432/openbinding
# GATEWAY_JWT_SECRET signs the session tokens: at least 32 random characters
# (for example `openssl rand -hex 32`). Shorter values are refused at startup
# outside APP_ENV=test, and APP_ENV=prod refuses to start without one. Never
# commit a value; docker-compose.yml requires it and ./up.sh generates one.
# GATEWAY_JWT_SECRET=
# Issuer and audience written to, and checked on, every session token.
# GATEWAY_JWT_ISSUER=
# GATEWAY_JWT_AUDIENCE=
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000

# Request body ceilings, enforced by an ASGI middleware before a body is buffered
# and while a chunked body streams; a larger body gets 413 (problem+json).
# MAX_REQUEST_BODY_BYTES is the ceiling of the artifact and package upload routes
# (keep nginx's client_max_body_size equal to it); MAX_JSON_BODY_BYTES applies to
# every other route and cannot exceed it. Values below are the defaults.
MAX_REQUEST_BODY_BYTES=536870912
MAX_JSON_BODY_BYTES=16777216

# Throttling of login, registration and token refresh: attempts per window per
# client address + identifier (Redis when reachable, per-process counters
# otherwise); 0 switches an individual limit off. The address alone gets
# AUTH_RATE_LIMIT_IP_MULTIPLIER times the budget. Values below are the defaults.
AUTH_RATE_LIMIT_WINDOW_S=300
AUTH_RATE_LIMIT_LOGIN_ATTEMPTS=10
AUTH_RATE_LIMIT_REGISTER_ATTEMPTS=5
AUTH_RATE_LIMIT_REFRESH_ATTEMPTS=30
AUTH_RATE_LIMIT_IP_MULTIPLIER=10

# Networks (comma-separated addresses or CIDRs) whose X-Forwarded-For uvicorn
# believes (--proxy-headers). Set it to the reverse proxy in front of the gateway,
# otherwise the throttling above counts every client as the proxy. Anything else
# can forge its own address.
FORWARDED_ALLOW_IPS=127.0.0.1

# Pricings, versions, plans and contracts belong to SPACE and SPHERE and are
# administered in their own consoles; this gateway holds no pricing of its own.
# It creates a user's contract and changes its plan through SPACE's official
# client, reads what a plan allows, and shows the published pricing read-only.
#
# SPACE_ENABLED=true uses the remote SPACE. SPACE_ENABLED=false builds a stateless
# open gate (every functional capability, no plans, no counters): development and
# QacoBench only. With APP_ENV=prod it makes the gateway refuse to start.
SPACE_ENABLED=false
# Origin of SPACE, HTTPS (for example https://space.score.us.es). The client
# appends /api/v1 itself, so do not include it.
SPACE_URL=
# SPACE API key with the MANAGEMENT scope; create it in the SPACE console.
SPACE_API_KEY=
SPACE_TIMEOUT_MS=5000
# The pricing version new contracts are pinned to and the public pricing page shows
# (for example 0.1.0). It must be deployed in SPACE and published in SPHERE.
SPACE_PRICING_VERSION=
# Plan a new sign-up starts on (for example BASIC). Empty: the account is created
# without a plan and SPACE assigns the contract's.
SPACE_DEFAULT_PLAN=

# SPHERE is read only here: the published pricing for the public page. The key is
# sent server-to-server and never reaches Vite.
SPHERE_ENABLED=false
# Origin of SPHERE (for example https://sphere.score.us.es); the client adds /api/v1.
SPHERE_URL=
SPHERE_API_KEY=
# Optional: pin the OpenBinding organization instead of looking it up by name.
SPHERE_ORGANIZATION_ID=

# Fernet keys protecting credentials registered with federated engines,
# comma-separated. The first key encrypts and every key decrypts: to rotate, put
# the new key first and drop the old one once nothing is encrypted with it.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_FERNET_KEYS=
# Single key of earlier deployments; still read (after the list above) so existing
# credentials stay readable. Prefer SECRETS_FERNET_KEYS.
# FEDERATION_SECRET_KEY=

# Whether a federated engine must be reached over TLS. The instance and the
# credential both travel to it, so leave this on anywhere real; turn it off
# only to test against a local stub without running a certificate authority.
# FEDERATION_REQUIRE_HTTPS=true

# The first administrator. Registration is open and produces ordinary users,
# so a fresh deployment has no administrator and no way to acquire one -
# promoting an account is itself an administrator's privilege. These seed or
# promote the first, and are ignored once any administrator exists.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Plan of that administrator; unset, SPACE assigns the contract's plan.
# BOOTSTRAP_ADMIN_PLAN=

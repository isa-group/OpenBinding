{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "netedu2020_transport_agency_mono_utility_hard_optimization"
  },
  "spec": {
    "criteria": [
      {
        "id": "availability",
        "feature": {
          "resource": "application",
          "id": "availability"
        },
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "id": "cost",
        "feature": {
          "resource": "application",
          "id": "cost"
        },
        "normalize": {
          "min": 0,
          "max": 1000,
          "clamp": true
        }
      },
      {
        "id": "execution_time",
        "feature": {
          "resource": "application",
          "id": "execution_time"
        },
        "normalize": {
          "min": 0,
          "max": 20000,
          "clamp": true
        }
      },
      {
        "id": "reliability",
        "feature": {
          "resource": "application",
          "id": "reliability"
        },
        "normalize": {
          "min": 0,
          "max": 1,
          "clamp": true
        }
      },
      {
        "id": "security",
        "feature": {
          "resource": "application",
          "id": "security"
        },
        "normalize": {
          "min": 1,
          "max": 5,
          "clamp": true
        }
      }
    ]
  }
}

{
  "metadata": {
    "id": "fms_knitting_fidelity_budget",
    "name": "FMS Knitting Workflow - Fidelity under Budget Cap",
    "version": "2.1.0",
    "created_at": "2026-07-19T00:00:00Z",
    "description": "Fidelity-under-budget profile of the motivating scenario (Section 3 of the paper): 30-qubit QAOA routing circuit wire-cut into two parallel 15-qubit sub-circuits (1024 shots each), selected over the illustrative catalog of Table 1."
  },
  "features": [
    {
      "id": "fidelity",
      "name": "Expected Fidelity",
      "direction": "MAXIMIZE",
      "unit": "probability",
      "scale": "RATIO",
      "valid_range": { "min": 0, "max": 1 },
      "description": "Expected execution fidelity of the sub-circuit on the offering."
    },
    {
      "id": "cost",
      "name": "Cost",
      "direction": "MINIMIZE",
      "unit": "EUR",
      "scale": "RATIO",
      "valid_range": { "min": 0, "max": 1000 },
      "description": "Execution cost of the sub-circuit (1024 shots) on the offering."
    },
    {
      "id": "queue",
      "name": "Queue Length",
      "direction": "MINIMIZE",
      "unit": "pending_jobs",
      "scale": "RATIO",
      "valid_range": { "min": 0, "max": 10000 },
      "description": "Pending jobs in the offering's queue at request time."
    },
    {
      "id": "num_qubits",
      "name": "Qubit Count",
      "direction": "MAXIMIZE",
      "unit": "count",
      "scale": "RATIO",
      "valid_range": { "min": 0, "max": 10000 },
      "description": "Device capacity; anchors the local capacity constraint."
    },
    {
      "id": "operational",
      "name": "Operational",
      "direction": "MAXIMIZE",
      "unit": "boolean",
      "scale": "RATIO",
      "valid_range": { "min": 0, "max": 1 },
      "description": "1 if the provider currently grants access to the resource (Table 1 status 'available'), 0 under maintenance or offline."
    },
    {
      "id": "real_device",
      "name": "Real Device",
      "direction": "MAXIMIZE",
      "unit": "boolean",
      "scale": "RATIO",
      "valid_range": { "min": 0, "max": 1 },
      "description": "1 for physical QPUs, 0 for simulators; anchors the user's real-device requirement."
    }
  ],
  "providers": [
    { "id": "ibmq", "name": "IBM Quantum" },
    { "id": "iqm", "name": "IQM Resonance" },

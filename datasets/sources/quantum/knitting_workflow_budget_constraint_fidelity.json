  "composition": {
    "type": "STRUCTURED",
    "root": {
      "id": "root_and",
      "kind": "AND",
      "children": [
        { "id": "node_t1", "kind": "TASK", "task_id": "t1" },
        { "id": "node_t2", "kind": "TASK", "task_id": "t2" }
      ]
    }
  },
  "aggregation_policies": {
    "fidelity": { "neutral": 1, "compose": { "and": { "fn": "PRODUCT" } } },
    "cost": { "neutral": 0, "compose": { "and": { "fn": "SUM" } } },
    "queue": { "neutral": 0, "compose": { "and": { "fn": "MAX" } } },
    "operational": { "neutral": 0, "compose": { "and": { "fn": "PRODUCT" } } },
    "num_qubits": { "neutral": 0, "compose": { "and": { "fn": "MIN" } } },
    "real_device": { "neutral": 0, "compose": { "and": { "fn": "PRODUCT" } } }
  },
  "constraints": [
    {
      "id": "capacity",
      "kind": "ATTRIBUTE_BOUND",
      "scope": "GLOBAL",
      "attribute_id": "num_qubits",
      "op": ">=",
      "value": 15.0,
      "hard": true,
      "description": "Capacity: each selected candidate must fit its 15-qubit sub-circuit. Excludes Spark."
    },
    {
      "id": "availability",
      "kind": "ATTRIBUTE_BOUND",
      "scope": "GLOBAL",
      "attribute_id": "operational",
      "op": ">=",
      "value": 1.0,
      "hard": true,
      "description": "Availability: the provider must currently grant access. Excludes Fez (maintenance) and IonQ Aria (offline)."
    },
    {
      "id": "real_device",
      "kind": "ATTRIBUTE_BOUND",
      "scope": "GLOBAL",
      "attribute_id": "real_device",
      "op": ">=",
      "value": 1.0,
      "hard": true,
      "description": "User requirement: execute on physical hardware. Excludes SV1."
    },
    {
      "id": "global_budget_cap",
      "kind": "ATTRIBUTE_BOUND",
      "scope": "GLOBAL",
      "attribute_id": "cost",
      "op": "<=",
      "value": 12.0,
      "hard": true,
      "description": "Global budget cap over the aggregated (summed) cost of the whole selection."
    }
  ],
  "objective": {
    "type": "MONO",
    "targets": ["fidelity"],
    "weights": { "fidelity": 1.0 },
    "weights_sum_to_one": true
  }

{
  "name": "openbinding-lab-pricing",
  "services": {
    "pricing-bootstrap": {
      "image": "openbinding-lab/pricing-bootstrap:1",
      "build": {"context": "lab/tools", "dockerfile": "Dockerfile"},
      "user": "1000:1000",
      "restart": "no",
      "environment": {
        "SPACE_URL": "https://space.score.us.es",
        "SPACE_API_KEY": "${DEMO_SPACE_MANAGEMENT_KEY}"
      },
      "mem_limit": "96m"
    }
  }
}

           "weight": 0.5
          },
          {
           "criteria": "cost",
           "feature": {
            "id": "cost",
            "resource": "app"
           },
           "loss": 0.6,
           "value": 12.0,
           "weight": 0.5
          }
         ],
         "penalty": 0,
         "scalarization": "weighted-sum",
         "score": 0.55,
         "type": "SINGLE"
        },
        "violations": []
       }
      ],
      "termination": "FEASIBLE"
     }
    },
    "method": "POST",
    "path": "/bim/v1/validate-result"
   }
  },
  {
   "description": "A field that bim-engine/v1 does not define.",
   "expect": {
    "body": {
     "error": {
      "code": "unknown_fields",
      "message": "engine response contains fields outside bim-engine/v1"
     },
     "valid": false
    },
    "status": 200
   },
   "id": "extra-field",

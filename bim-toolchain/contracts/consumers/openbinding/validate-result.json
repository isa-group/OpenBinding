{
 "consumer": "openbinding",
 "description": "Shape validation of bim-engine/v1 results (not a check that the numbers are right).",
 "name": "validate-result",
 "schema": "bim-toolchain/consumer-fixture/1",
 "steps": [
  {
   "description": "A well-formed answer.",
   "expect": {
    "body": {
     "error": null,
     "valid": true
    },
    "status": 200
   },
   "id": "valid",
   "request": {
    "body": {
     "result": {
      "provenance": {
       "engine": "consumer-fixture"
      },
      "solutions": [
       {
        "decision": {
         "binding": {
          "t1": {
           "id": "c1",
           "resource": "cat-a"
          },
          "t2": {
           "id": "c1",
           "resource": "cat-b"
          }
         },
         "kind": "binding"
        },
        "features": {
         "cost": 12.0,
         "latency": 50.0
        },
        "objectives": {
         "components": [
          {
           "criteria": "latency",
           "feature": {
            "id": "latency",
            "resource": "app"
           },
           "loss": 0.5,
           "value": 50.0,
           "weight": 0.5
          },
          {
           "criteria": "cost",
           "feature": {
            "id": "cost",
            "resource": "app"
           },
           "loss": 0.6,
           "value": 12.0,
           "weight": 0.5
          }
         ],
         "penalty": 0,
         "scalarization": "weighted-sum",
         "score": 0.55,
         "type": "SINGLE"
        },
        "penalties": [
         0.0
        ],
        "violations": []
       }
      ],
      "termination": "FEASIBLE"
     }
    },
    "method": "POST",
    "path": "/bim/v1/validate-result"
   }
  },
  {
   "description": "A solution without `penalties`.",
   "expect": {
    "body": {
     "error": {
      "code": "solution_decision_invalid",
      "message": "every engine solution must contain a canonical binding decision"
     },
     "valid": false
    },
    "status": 200
   },
   "id": "missing-field",
   "request": {
    "body": {
     "result": {
      "provenance": {
       "engine": "consumer-fixture"
      },
      "solutions": [

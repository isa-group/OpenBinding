{
  "name": "openbinding-engines-java",
  "services": {
    "engines-java-random-search": {
      "profiles": ["seed"],
      "build": {
        "context": "engines",
        "dockerfile": "random-search/Dockerfile",
        "target": "builder"
      },
      "user": "65534:65534",
      "working_dir": "/tmp",
      "command": [
        "sh",
        "-ec",
        "cp -r /app /tmp/work && cd /tmp/work/binding-core && mvn -B -q -Dmaven.repo.local=/tmp/m2 -DskipTests install && cd /tmp/work/random-search && mvn -B -Dmaven.repo.local=/tmp/m2 test && echo engines-java-random-search-ok"
      ],
      "environment": {
        "HOME": "/tmp",
        "MAVEN_OPTS": "-Xmx384m"
      },
      "volumes": [
        {
          "type": "tmpfs",
          "target": "/tmp",
          "tmpfs": {
            "mode": 1023,
            "size": 268435456
          }
        }
      ],
      "restart": "no",
      "mem_limit": "768m"
    },
    "engines-java-many-heuristic": {

# Every variable compose.lab.json reads, for a complete env file (docker compose --env-file).
# Copy it, fill in the secrets, and keep the copy out of the repository. docs/DEMO.md describes each one.
# lab/tests/test_lab_compose_config.py holds this list to the variables the compose file references.
#
# The gateway image's build also needs BIM_TOOLCHAIN_TOKEN in the builder's environment (a build secret that
# reads the private bim-toolchain release, for example `gh auth token`); it is not an env-file variable.

# Secrets: generate them, never reuse a real one. Every line below is a plain KEY=value, comments on lines of their own.
# openssl rand -hex 16
DEMO_PG_PASSWORD=
# openssl rand -hex 32
DEMO_JWT_SECRET=
# python3 -c 'import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
DEMO_FERNET_KEY=
# At least 10 characters: the synthetic users' password, and what the lab's API and feed keys derive from.
DEMO_SEED_PASSWORD=

# The lab's address.
DEMO_LAB_PORT=18100
DEMO_PUBLIC_ORIGIN=http://localhost:18100

# The seed service (tools/seed_lab.py, or smoke_lab.py for the API smoke).
DEMO_SEED_TOOL=seed_lab.py
DEMO_SEED_ARGS=
# 1 runs the live browser walks when the e2e service starts; 0 leaves it idle.
DEMO_E2E=0

# SPACE (pricing and contracts): off in a lab without a SPACE organization.
DEMO_SPACE_ENABLED=false
DEMO_SPACE_PRICING_VERSION=0.2.0
DEMO_SPACE_DEFAULT_PLAN=FREE
DEMO_SPACE_DEV_PLAN=FREE
DEMO_SPACE_DEV_SERVICE=openbinding-dev
SPACE_URL=
SPACE_API_KEY=
SPACE_ORGANIZATION_ID=

# SPHERE: the lab reads its own SPHERE stand-in (service sphere-lab, tools/sphere_lab.py): the recorded public
# pricings plus the synthetic upstream versions a demo publishes, over plain http inside the compose network (allowed
# only with SPHERE_REQUIRE_HTTPS=false, which production refuses). Requests it has no recording for go to the public
# SPHERE anonymously (passthrough), except the scenario families, which always answer locally. "Open in SPHERE" links
# point at the public SPHERE. The upstream watcher polls every 20 s (300 s by default; at least 60 s against a real
# SPHERE, which lab/tests/test_lab_compose.py holds this file to).
# Against the public SPHERE instead: SPHERE_URL=https://sphere.score.us.es DEMO_SPHERE_REQUIRE_HTTPS=true
# DEMO_UPSTREAM_POLL_S=300 (the stand-in still runs, unused, and no upstream change ever appears).
SPHERE_URL=http://sphere-lab:8080
DEMO_SPHERE_REQUIRE_HTTPS=false
SPHERE_PUBLIC_URL=https://sphere.score.us.es
DEMO_UPSTREAM_POLL_S=20
DEMO_SPHERE_LAB_PASSTHROUGH=https://sphere.score.us.es

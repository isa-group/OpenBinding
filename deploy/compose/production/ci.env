# Placeholders so that `docker compose config` can render compose.yaml in CI. They are not site values and hold no
# secret. On the host, the same names are set in site.env (never in Git); see docs/runbooks/production.md.
PUBLIC_ORIGIN=https://openbinding.example.org
OPENBINDING_SECRETS_DIR=/srv/openbinding/secrets
OPENBINDING_BACKUP_DIR=/srv/openbinding/backups
BACKUP_RETENTION_DAYS=14
NGINX_SSL_DIR=/srv/openbinding/tls
SPACE_URL=https://space.example.org

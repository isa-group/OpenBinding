{
  "apiVersion": "qos-binding/v1",
  "kind": "Optimization",
  "metadata": {
    "name": "demo_01_simple_seq_optimization"
  },
  "spec": {
    "criteria": [
      {
        "id": "latency",
        "feature": {
          "resource": "application",
          "id": "latency"

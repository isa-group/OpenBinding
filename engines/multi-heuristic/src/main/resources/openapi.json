{
  "openapi": "3.1.0",
  "info": {
    "title": "Federated Multi-Heuristic BIM Engine",
    "version": "1.1.0"
  },
  "x-bim-protocol": "bim-engine/v1",
  "x-bim-protocol-digest": "sha256-68c0805083caebdbfea967ffc5447b215c63b1e70792cc969cbb8d3768d3d628",
  "paths": {
    "/internal/v1/binding-problems": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/BindingProblemRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed result.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/BindingResult"}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {"description": "Engine is ready."}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ref": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "id"],
        "properties": {
          "resource": {"type": "string", "minLength": 1},
          "id": {"type": "string", "minLength": 1}
        }
      },
      "BindingProblem": {
        "$ref": "./bim/v1/binding-problem.schema.json"
      },
      "BindingProblemRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiVersion", "kind", "protocol", "problem"],
        "properties": {
          "apiVersion": {"const": "bim/v1"},
          "kind": {"const": "BindingProblemRequest"},
          "protocol": {"const": "bim-engine/v1"},
          "problem": {"$ref": "#/components/schemas/BindingProblem"},
          "options": {"type": "object"}
        }
      },
      "BindingDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "binding"],
        "properties": {
          "kind": {"const": "binding"},
          "binding": {
            "type": "object",
            "additionalProperties": {"$ref": "#/components/schemas/Ref"}
          }
        }
      },
      "Violation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint", "enforcement", "penalty"],
        "properties": {
          "constraint": {"$ref": "#/components/schemas/Ref"},
          "enforcement": {"type": "string", "enum": ["hard", "soft"]},
          "penalty": {"type": "number", "minimum": 0},
          "message": {"type": "string"}
        }
      },
      "ObjectiveComponent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "value", "loss", "weight"],
        "properties": {
          "feature": {"$ref": "#/components/schemas/Ref"},
          "value": {"type": "number"},
          "loss": {"type": "number"},
          "weight": {"type": "number", "exclusiveMinimum": 0}
        }
      },
      "ObjectiveEvaluation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "components", "penalty", "score"],
        "properties": {
          "mode": {"type": "string", "enum": ["satisfy", "weighted", "lexicographic", "pareto"]},
          "components": {"type": "array", "items": {"$ref": "#/components/schemas/ObjectiveComponent"}},
          "penalty": {"type": "number", "minimum": 0},
          "score": {
            "oneOf": [
              {"type": "number"},
              {"type": "array", "items": {"type": "number"}}
            ]
          }
        }
      },
      "BindingSolution": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "features", "objectives", "penalties", "violations"],
        "properties": {
          "decision": {"$ref": "#/components/schemas/BindingDecision"},
          "features": {"type": "object", "additionalProperties": {"type": "number"}},
          "objectives": {"$ref": "#/components/schemas/ObjectiveEvaluation"},
          "penalties": {"type": "array", "items": {"type": "number", "minimum": 0}},
          "violations": {"type": "array", "items": {"$ref": "#/components/schemas/Violation"}}
        }
      },
      "BindingResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["termination", "solutions"],
        "properties": {
          "termination": {"type": "string", "enum": ["OPTIMAL", "FEASIBLE", "INFEASIBLE", "UNKNOWN"]},
          "solutions": {"type": "array", "items": {"$ref": "#/components/schemas/BindingSolution"}},
          "provenance": {"type": "object"}
        }
      }
    }
  }
}
